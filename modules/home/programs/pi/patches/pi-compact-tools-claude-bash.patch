Claude-style bash rows, with syntax-highlighting recoloring them from outside:
- A multi-line command reaches the title already folded by syntax-highlighting
  (one line, its preview once opened, all of it with ctrl+shift+o), so it is
  not cut a second time; a single long line still is, past 160 characters.
- An opened command ends with Pi's own "Took 4.2s" in the body column, where
  auto-mode puts "Allowed by auto mode" beside it.

diff -ru a/extensions/compact-tools-claude.ts b/extensions/compact-tools-claude.ts
--- a/extensions/compact-tools-claude.ts
+++ b/extensions/compact-tools-claude.ts
@@ -77,9 +77,10 @@
 export function claudeCommand(command: string, expanded: boolean): string {
 	const text = normalizeLineEndings(stripTerminalSequences(command)).trim();
 	if (expanded) return text;
-	const lines = text.split("\n");
-	let shown = lines.length > CLAUDE_COMMAND_LINES ? lines.slice(0, CLAUDE_COMMAND_LINES).join("\n") : text;
-	if (shown.length > CLAUDE_COMMAND_CHARS) shown = shown.slice(0, CLAUDE_COMMAND_CHARS);
+	// Several lines come folded by syntax-highlighting already, or whole when its
+	// ctrl+shift+o asks for them: they are not cut a second time.
+	if (text.includes("\n")) return text;
+	const shown = text.length > CLAUDE_COMMAND_CHARS ? text.slice(0, CLAUDE_COMMAND_CHARS) : text;
 	return shown === text ? text : `${shown.trim()}…`;
 }
 
