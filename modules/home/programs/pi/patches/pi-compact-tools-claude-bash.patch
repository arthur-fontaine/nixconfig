+/**
+ * An opened command's last body line: Pi's own `Took 4.2s` (formatToolDuration), so
+ * what other extensions place beside Pi's timer, auto-mode's note, finds it.
+ */
+function claudeTook(state: RowState, theme: Theme): Component | undefined {
+	const ms = state.durationMs ?? (state.startedAt === undefined ? undefined : (state.endedAt ?? Date.now()) - state.startedAt);
+	if (ms === undefined) return undefined;
+	const seconds = ms / 1000;
+	const minutes = Math.floor(seconds / 60);
+	const rest = Math.floor(seconds) % 60;
+	const text = seconds < 60 ? `${seconds.toFixed(1)}s` : minutes < 60 ? `${minutes}m ${rest}s` : `${Math.floor(minutes / 60)}h ${minutes % 60}m ${rest}s`;
+	return prefixedText(theme.fg("muted", `Took ${text}`), CLAUDE_INDENT);
+}
+
 function claudeMoreLines(theme: Theme, hidden: number): string {
 	return chromePainter(theme)(`… +${hidden} ${hidden === 1 ? "line" : "lines"} (ctrl+o to expand)`);
 }
