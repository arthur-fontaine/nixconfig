+/**
+ * The context of a turn that made several requests (an advisor call between two of them): the
+ * last request's tokens. Claude Code sums the requests into one usage, so the conversation counts
+ * twice and Pi would compact at half its window. undefined: the turn's own sum stands.
+ */
+export function turnContextTokens(usage: Partial<NativeUsage>): number | undefined {
+  const iterations = (usage as { iterations?: unknown }).iterations;
+  if (!Array.isArray(iterations)) return undefined;
+  const requests = iterations.filter((i) => i && typeof i === "object" && (i as { type?: unknown }).type === "message");
+  if (requests.length < 2) return undefined;
+  const last = requests[requests.length - 1] as Record<string, unknown>;
+  const n = (k: string) => (typeof last[k] === "number" ? (last[k] as number) : 0);
+  return n("input_tokens") + n("output_tokens") + n("cache_read_input_tokens") + n("cache_creation_input_tokens");
+}
+
 function updateUsage(output: AssistantMessage, model: Model<any>, usage: Partial<NativeUsage> | undefined): void {
   if (!usage) return;
   if (typeof usage.input_tokens === "number") output.usage.input = usage.input_tokens;
@@ -103,7 +118,10 @@ function updateUsage(output: AssistantMessage, model: Model<any>, usage: Partial
   if (typeof oneHour === "number") output.usage.cacheWrite1h = oneHour;
   const thinking = usage.output_tokens_details?.thinking_tokens;
   if (typeof thinking === "number") output.usage.reasoning = thinking;
+  // The components stay summed (every request was billed); only the context figure Pi
+  // compacts on is the last request's.
   output.usage.totalTokens =
+    turnContextTokens(usage) ??
     output.usage.input + output.usage.output + output.usage.cacheRead + output.usage.cacheWrite;
   calculateCost(model, output.usage);
 }
diff --git a/tests/context-tokens.test.ts b/tests/context-tokens.test.ts
