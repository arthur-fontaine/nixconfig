+++ b/tests/context-tokens.test.ts
@@ -0,0 +1,26 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+import { turnContextTokens } from "../src/stream.ts";
+
+// Real usage of msg_011Ch8tJAuojFiYWyPC6f4rw: an advisor call between two requests of one turn.
+const advised = {
+  input_tokens: 4,
+  output_tokens: 302,
+  cache_read_input_tokens: 553830,
+  cache_creation_input_tokens: 3778,
+  iterations: [
+    { type: "message", input_tokens: 2, output_tokens: 100, cache_read_input_tokens: 275543, cache_creation_input_tokens: 2744 },
+    { type: "advisor_message", model: "claude-fable-5-2", input_tokens: 281430, output_tokens: 11616, cache_read_input_tokens: 0, cache_creation_input_tokens: 0 },
+    { type: "message", input_tokens: 2, output_tokens: 202, cache_read_input_tokens: 278287, cache_creation_input_tokens: 1034 },
+  ],
+};
+
+test("a turn's context is its last request, not the sum of its requests", () => {
+  assert.equal(turnContextTokens(advised), 2 + 202 + 278287 + 1034);
+});
+
+test("without iterations, or with one request, the turn's own sum stands", () => {
+  assert.equal(turnContextTokens({ input_tokens: 4, output_tokens: 302, cache_read_input_tokens: 10, cache_creation_input_tokens: 5 }), undefined);
+  assert.equal(turnContextTokens({ input_tokens: 4, output_tokens: 1, iterations: [{ type: "message", input_tokens: 4, output_tokens: 1 }] }), undefined);
+  assert.equal(turnContextTokens({ input_tokens: 4, output_tokens: 1, iterations: "bad" }), undefined);
+});
