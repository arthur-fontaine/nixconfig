+/**
+ * Claude Code's advisor: a stronger model (Fable, say) that the main model consults through
+ * Anthropic's server-side `advisor_20260301` tool, inside the main request. Claude Code
+ * attaches the tool itself from its `advisorModel` setting, so the request is the one Claude
+ * Code would send and is billed as Claude Code's advisor is; Pi only keeps that tool when it
+ * swaps in its own tools, and keeps the advisor's blocks in the replayed history.
+ */
+import type { NativeContentBlock } from "./native-types.ts";
+
+export const ADVISOR_BETA = "advisor-tool-2026-03-01";
+
+let source: () => unknown = () => undefined;
+
+/** Where the advisor model comes from: Pi's `advisorModel` setting (index.ts). */
+export function setAdvisorSource(get: () => unknown): void {
+  source = get;
+}
+
+/** The configured advisor model ("fable", "opus", a full id), or undefined when off. */
+export function advisorModel(): string | undefined {
+  let value: unknown;
+  try {
+    value = source();
+  } catch {
+    return undefined;
+  }
+  if (typeof value !== "string") return undefined;
+  const model = value.trim();
+  return model && model.toLowerCase() !== "off" ? model : undefined;
+}
+
+type Tool = Record<string, unknown>;
+
+const isAdvisorTool = (tool: unknown): tool is Tool =>
+  !!tool && typeof tool === "object" && /^advisor_\d+$/u.test(String((tool as Tool).type));
+
+/**
+ * Pi's tools in place of Claude Code's (its MCP stand-ins), with Claude Code's advisor tool
+ * kept as Claude Code built it, last, where Claude Code puts it. Claude Code leaves it out
+ * when it won't apply the advisor (unsupported pairing, no Fable consent), and so does this.
+ */
+export function withPiTools(body: Buffer, piTools: unknown): Buffer {
+  const payload = JSON.parse(body.toString("utf8")) as { tools?: unknown[] };
+  const advisor = (payload.tools ?? []).filter(isAdvisorTool);
+  payload.tools = [...(Array.isArray(piTools) ? structuredClone(piTools) : []), ...advisor];
+  return Buffer.from(JSON.stringify(payload));
+}
+
+/** Whether replayed history holds advisor blocks, which the API only takes with the beta. */
+export function historyHasAdvisor(frames: Array<{ message: { content: unknown[] } }>): boolean {
+  return frames.some((frame) =>
+    frame.message.content.some((block) => {
+      const type = (block as { type?: unknown } | null)?.type;
+      return type === "advisor_tool_result" || (type === "server_tool_use" && (block as Tool).name === "advisor");
+    }),
+  );
+}
+
+export type AdvisorEvent =
+  | { phase: "start"; id: string }
+  | { phase: "end"; id: string; outcome: AdvisorOutcome };
+
+/**
+ * What the advisor returned. Its guidance is readable text (`advisor_result`) from some
+ * advisors only: Fable, Opus 5 and later send it encrypted (`advisor_redacted_result`), for the
+ * main model alone.
+ */
+export type AdvisorOutcome =
+  | { kind: "reviewed"; text: string }
+  | { kind: "reviewed"; encrypted: true }
+  | { kind: "unavailable"; errorCode: string };
+
+function outcomeOf(content: Tool | undefined): AdvisorOutcome {
+  if (content?.type === "advisor_tool_result_error") {
+    return { kind: "unavailable", errorCode: String(content.error_code ?? "unknown") };
+  }
+  if (content?.type === "advisor_result" && typeof content.text === "string") return { kind: "reviewed", text: content.text };
+  return { kind: "reviewed", encrypted: true };
+}
+
+const listeners = new Set<(event: AdvisorEvent) => void>();
+
+export function onAdvisor(listener: (event: AdvisorEvent) => void): () => void {
+  listeners.add(listener);
+  return () => listeners.delete(listener);
+}
+
+/** Tells the UI about an advisor block as it starts streaming; true if it was one. */
+export function advisorBlock(block: NativeContentBlock): boolean {
+  const raw = block as Tool;
+  let event: AdvisorEvent | undefined;
+  if (raw.type === "server_tool_use" && raw.name === "advisor") {
+    event = { phase: "start", id: String(raw.id) };
+  } else if (raw.type === "advisor_tool_result") {
+    event = { phase: "end", id: String(raw.tool_use_id), outcome: outcomeOf(raw.content as Tool | undefined) };
+  } else {
+    return false;
+  }
+  for (const listener of listeners) {
+    try {
+      listener(event);
+    } catch {}
+  }
+  return true;
+}
+
+/** "fable" → "Fable", "claude-fable-5-2" → "Fable 5.2". */
+export function advisorLabel(model: string): string {
+  const match = /^(?:claude-)?([a-z]+)(?:-(\d+(?:-\d+)?))?/iu.exec(model.trim());
+  if (!match) return model;
+  const family = match[1]!.charAt(0).toUpperCase() + match[1]!.slice(1).toLowerCase();
+  return match[2] ? `${family} ${match[2].replace("-", ".")}` : family;
+}
