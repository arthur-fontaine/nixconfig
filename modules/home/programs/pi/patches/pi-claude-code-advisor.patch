new file mode 100644
index 0000000..a5634a2
--- /dev/null
+++ b/src/advisor-row.ts
@@ -0,0 +1,68 @@
+/**
+ * The advisor's row in Pi's transcript: one line, as Claude Code's, which opens on what the
+ * advisor said as a tool row opens on its output: a click toggles this row, Ctrl+O (Pi's
+ * app.tools.expand) sets every row. Encrypted guidance can't be shown; the row says so.
+ */
+import { MouseRegion, wrapTextWithAnsi, type Component } from "@earendil-works/pi-tui";
+import type { AdvisorOutcome } from "./advisor.ts";
+
+export const ADVISOR_ENTRY = "claude-code-advisor";
+
+export interface AdvisorEntryData {
+  label?: string;
+  outcome?: AdvisorOutcome;
+}
+
+interface Paint {
+  fg(color: string, text: string): string;
+  bold?(text: string): string;
+}
+
+// tool-rows-faint's fade, which Pi's tool rows and the thinking rows are drawn with: an entry
+// isn't a tool row, so it is asked for here. Without that extension, lines stay as they are.
+type SharedFade = { line(theme: Paint, text: string): string };
+const fade = (theme: Paint, line: string) =>
+  (globalThis as Record<symbol, SharedFade | undefined>)[Symbol.for("pi-extension-tool-rows-faint")]?.line(theme, line) ?? line;
+
+// compact-tools' Claude-style rail under a row's title, and the column its text continues at.
+const RAIL = "   ⎿  ";
+const BODY = "      ";
+
+/**
+ * The row's lines at a width: the title, and when open the advice under "⎿", indented. `pad` is
+ * Pi's outputPad, which it gives tool and thinking rows but not an extension's own entry.
+ */
+export function advisorLines(data: AdvisorEntryData, expanded: boolean, theme: Paint, width = 80, pad = 1): string[] {
+  const { label, outcome } = data;
+  const failed = outcome?.kind === "unavailable";
+  const detail = failed ? ` unavailable (${outcome.errorCode})` : ` (${label ?? "?"}) reviewed the conversation`;
+  const indent = " ".repeat(pad);
+  // As compact-tools paints a finished tool row and thinking-rows a thinking one.
+  const bold = theme.bold ?? ((text: string) => text);
+  const head = `${indent}${theme.fg(failed ? "error" : "success", "⦁")} ${theme.fg("toolTitle", bold("Advisor"))}${theme.fg("toolOutput", detail)}`;
+  if (!expanded || outcome?.kind !== "reviewed") return [fade(theme, head)];
+  const body = "text" in outcome ? outcome.text.trim() : "";
+  const lines = body
+    ? body.split("\n").flatMap((line) => (line ? wrapTextWithAnsi(line, Math.max(10, width - pad - BODY.length)) : [""])).map((line) => theme.fg("toolOutput", line))
+    : [theme.fg("dim", "Guidance is encrypted, not readable")];
+  const rail = (index: number) => (index === 0 ? theme.fg("dim", RAIL) : BODY);
+  return [head, ...lines.map((line, index) => indent + rail(index) + line)].map((line) => fade(theme, line));
+}
+
+// A click's choice per entry, kept while Ctrl+O's state is the one it was made under: Pi draws
+// the row anew on Ctrl+O and on theme or width changes, and only Ctrl+O should undo a click.
+const clicked = new Map<string, { under: boolean; open: boolean }>();
+
+export function advisorRow(entry: { id: string; data?: unknown }, expanded: boolean, theme: Paint, pad = 1): Component {
+  const data = (entry.data ?? {}) as AdvisorEntryData;
+  const choice = clicked.get(entry.id);
+  if (choice && choice.under !== expanded) clicked.delete(entry.id);
+  let open = clicked.get(entry.id)?.open ?? expanded;
+  const view: Component = { render: (width) => advisorLines(data, open, theme, width, pad), invalidate() {} };
+  return new MouseRegion(view, (event) => {
+    if (event.type !== "click" || event.button !== "left") return undefined;
+    open = !open;
+    clicked.set(entry.id, { under: expanded, open });
+    return { handled: true };
+  });
+}
