diff --git a/tests/advisor.test.ts b/tests/advisor.test.ts
new file mode 100644
index 0000000..8d669a8
--- /dev/null
+++ b/tests/advisor.test.ts
@@ -0,0 +1,62 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+import {
+  advisorBlock,
+  advisorLabel,
+  advisorModel,
+  historyHasAdvisor,
+  onAdvisor,
+  setAdvisorSource,
+  withPiTools,
+  type AdvisorEvent,
+} from "../src/advisor.ts";
+
+const advisor = { type: "advisor_20260301", name: "advisor", model: "claude-fable-5-2" };
+const piTools = [{ name: "mcp__pi__bash", description: "b", input_schema: { type: "object", properties: {} } }];
+
+test("Pi's tools replace Claude Code's, and Claude Code's advisor tool stays last, as built", () => {
+  const body = Buffer.from(JSON.stringify({ tools: [{ name: "mcp__pi__bash", description: "stand-in" }, advisor] }));
+  assert.deepEqual(JSON.parse(withPiTools(body, piTools).toString()).tools, [...piTools, advisor]);
+  // Claude Code declined the advisor: none is added.
+  const without = Buffer.from(JSON.stringify({ tools: [{ name: "mcp__pi__bash" }] }));
+  assert.deepEqual(JSON.parse(withPiTools(without, piTools).toString()).tools, piTools);
+});
+
+test("advisorModel follows the setting; unset, empty or off is no advisor", () => {
+  for (const [value, expected] of [["fable", "fable"], [" opus ", "opus"], ["off", undefined], ["", undefined], [undefined, undefined], [3, undefined]] as const) {
+    setAdvisorSource(() => value);
+    assert.equal(advisorModel(), expected);
+  }
+  setAdvisorSource(() => {
+    throw new Error("settings unreadable");
+  });
+  assert.equal(advisorModel(), undefined);
+  setAdvisorSource(() => undefined);
+});
+
+test("advisor blocks in history are found, and announced as they stream", () => {
+  const use = { type: "server_tool_use", id: "srvtoolu_1", name: "advisor", input: {} };
+  const result = { type: "advisor_tool_result", tool_use_id: "srvtoolu_1", content: { type: "advisor_redacted_result", encrypted_content: "x" } };
+  const failed = { type: "advisor_tool_result", tool_use_id: "srvtoolu_2", content: { type: "advisor_tool_result_error", error_code: "overloaded" } };
+  assert.equal(historyHasAdvisor([{ message: { content: [{ type: "text", text: "hi" }] } }]), false);
+  assert.equal(historyHasAdvisor([{ message: { content: [use, result] } }]), true);
+
+  const events: AdvisorEvent[] = [];
+  const off = onAdvisor((event) => events.push(event));
+  assert.equal(advisorBlock({ type: "text", text: "" }), false);
+  assert.equal(advisorBlock(use as never), true);
+  assert.equal(advisorBlock(result as never), true);
+  assert.equal(advisorBlock(failed as never), true);
+  off();
+  assert.deepEqual(events, [
+    { phase: "start", id: "srvtoolu_1" },
+    { phase: "end", id: "srvtoolu_1", outcome: { kind: "reviewed" } },
+    { phase: "end", id: "srvtoolu_2", outcome: { kind: "unavailable", errorCode: "overloaded" } },
+  ]);
+});
+
+test("advisor labels read like Claude Code's model names", () => {
+  assert.equal(advisorLabel("fable"), "Fable");
+  assert.equal(advisorLabel("claude-fable-5-2"), "Fable 5.2");
+  assert.equal(advisorLabel("claude-opus-5"), "Opus 5");
+});
