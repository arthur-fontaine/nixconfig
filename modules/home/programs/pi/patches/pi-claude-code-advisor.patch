diff --git a/tests/advisor.test.ts b/tests/advisor.test.ts
new file mode 100644
index 0000000..fc98db4
--- /dev/null
+++ b/tests/advisor.test.ts
@@ -0,0 +1,140 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+import {
+  advisorBlock,
+  advisorLabel,
+  advisorModel,
+  historyHasAdvisor,
+  onAdvisor,
+  setAdvisorSource,
+  withPiTools,
+  type AdvisorEvent,
+} from "../src/advisor.ts";
+import { advisorLines, advisorRow } from "../src/advisor-row.ts";
+
+const advisor = { type: "advisor_20260301", name: "advisor", model: "claude-fable-5-2" };
+const piTools = [{ name: "mcp__pi__bash", description: "b", input_schema: { type: "object", properties: {} } }];
+
+test("Pi's tools replace Claude Code's, and Claude Code's advisor tool stays last, as built", () => {
+  const body = Buffer.from(JSON.stringify({ tools: [{ name: "mcp__pi__bash", description: "stand-in" }, advisor] }));
+  assert.deepEqual(JSON.parse(withPiTools(body, piTools).toString()).tools, [...piTools, advisor]);
+  // Claude Code declined the advisor: none is added.
+  const without = Buffer.from(JSON.stringify({ tools: [{ name: "mcp__pi__bash" }] }));
+  assert.deepEqual(JSON.parse(withPiTools(without, piTools).toString()).tools, piTools);
+});
+
+test("advisorModel follows the setting; unset, empty or off is no advisor", () => {
+  for (const [value, expected] of [["fable", "fable"], [" opus ", "opus"], ["off", undefined], ["", undefined], [undefined, undefined], [3, undefined]] as const) {
+    setAdvisorSource(() => value);
+    assert.equal(advisorModel(), expected);
+  }
+  setAdvisorSource(() => {
+    throw new Error("settings unreadable");
+  });
+  assert.equal(advisorModel(), undefined);
+  setAdvisorSource(() => undefined);
+});
+
+test("advisor blocks in history are found, and announced as they stream", () => {
+  const use = { type: "server_tool_use", id: "srvtoolu_1", name: "advisor", input: {} };
+  const result = { type: "advisor_tool_result", tool_use_id: "srvtoolu_1", content: { type: "advisor_redacted_result", encrypted_content: "x" } };
+  const failed = { type: "advisor_tool_result", tool_use_id: "srvtoolu_2", content: { type: "advisor_tool_result_error", error_code: "overloaded" } };
+  assert.equal(historyHasAdvisor([{ message: { content: [{ type: "text", text: "hi" }] } }]), false);
+  assert.equal(historyHasAdvisor([{ message: { content: [use, result] } }]), true);
+
+  const events: AdvisorEvent[] = [];
+  const off = onAdvisor((event) => events.push(event));
+  assert.equal(advisorBlock({ type: "text", text: "" }), false);
+  assert.equal(advisorBlock(use as never), true);
+  assert.equal(advisorBlock(result as never), true);
+  assert.equal(advisorBlock(failed as never), true);
+  off();
+  assert.deepEqual(events, [
+    { phase: "start", id: "srvtoolu_1" },
+    { phase: "end", id: "srvtoolu_1", outcome: { kind: "reviewed", encrypted: true } },
+    { phase: "end", id: "srvtoolu_2", outcome: { kind: "unavailable", errorCode: "overloaded" } },
+  ]);
+});
+
+test("advisor labels read like Claude Code's model names", () => {
+  assert.equal(advisorLabel("fable"), "Fable");
+  assert.equal(advisorLabel("claude-fable-5-2"), "Fable 5.2");
+  assert.equal(advisorLabel("claude-opus-5"), "Opus 5");
+});
+
+test("readable advice reaches the entry's outcome, encrypted advice is marked so", () => {
+  const events: AdvisorEvent[] = [];
+  const off = onAdvisor((event) => events.push(event));
+  advisorBlock({ type: "advisor_tool_result", tool_use_id: "s", content: { type: "advisor_result", text: "Close the channel first." } } as never);
+  advisorBlock({ type: "advisor_tool_result", tool_use_id: "s", content: { type: "advisor_redacted_result", encrypted_content: "x" } } as never);
+  off();
+  assert.deepEqual(events.map((e) => e.phase === "end" && e.outcome), [
+    { kind: "reviewed", text: "Close the channel first." },
+    { kind: "reviewed", encrypted: true },
+  ]);
+});
+
+const plain = { fg: (_color: string, text: string) => text };
+
+test("the advisor row is one line, and opens on the advice or on why there is none", () => {
+  const readable = { label: "Opus 4.8", outcome: { kind: "reviewed" as const, text: "Use a WaitGroup.\nDrain first." } };
+  assert.deepEqual(advisorLines(readable, false, plain), [" ⦁ Advisor (Opus 4.8) reviewed the conversation"]);
+  assert.deepEqual(advisorLines(readable, true, plain), [" ⦁ Advisor (Opus 4.8) reviewed the conversation", "    ⎿  Use a WaitGroup.", "       Drain first."]);
+  // Long advice wraps under its indent.
+  const long = { label: "Opus 4.8", outcome: { kind: "reviewed" as const, text: "word ".repeat(30).trim() } };
+  const wrapped = advisorLines(long, true, plain, 40).slice(1);
+  assert.ok(wrapped.length > 1 && wrapped.every((line, i) => line.startsWith(i ? "       " : "    ⎿  ") && line.length <= 40));
+  const encrypted = { label: "Fable", outcome: { kind: "reviewed" as const, encrypted: true as const } };
+  assert.deepEqual(advisorLines(encrypted, true, plain), [" ⦁ Advisor (Fable) reviewed the conversation", "    ⎿  Guidance is encrypted, not readable"]);
+  const failed = { label: "Fable", outcome: { kind: "unavailable" as const, errorCode: "overloaded" } };
+  assert.deepEqual(advisorLines(failed, true, plain), [" ⦁ Advisor unavailable (overloaded)"]);
+});
+
+test("the advisor row lines up with tool rows: Pi's outputPad, then compact-tools' dot and rail", () => {
+  // compact-tools' Claude rows, as Pi pads them: " ⦁ Bash(ls)", "    ⎿  a.txt", "       b.txt".
+  const toolRow = [" ⦁ Bash(ls)", "    ⎿  a.txt", "       b.txt"];
+  const row = advisorLines({ label: "Opus", outcome: { kind: "reviewed", text: "a.txt\nb.txt" } }, true, plain);
+  assert.equal(row[0]!.indexOf("⦁"), toolRow[0]!.indexOf("⦁"));
+  assert.equal(row[1]!.indexOf("⎿"), toolRow[1]!.indexOf("⎿"));
+  assert.equal(row[1]!.indexOf("a.txt"), toolRow[1]!.indexOf("a.txt"));
+  assert.equal(row[2]!.indexOf("b.txt"), toolRow[2]!.indexOf("b.txt"));
+  // outputPad 0: no column before the dot, as Pi draws the other rows then.
+  assert.deepEqual(advisorLines({ label: "Opus", outcome: { kind: "reviewed", text: "x" } }, true, plain, 80, 0), ["⦁ Advisor (Opus) reviewed the conversation", "   ⎿  x"]);
+});
+
+test("a click toggles the row, and Ctrl+O sets it again", () => {
+  const entry = { id: "e1", data: { label: "Fable", outcome: { kind: "reviewed", text: "Advice." } } };
+  const click = { type: "click", button: "left" } as never;
+  const lines = (row: { render(width: number): string[] }) => row.render(80).map((line) => line.trimEnd()).filter(Boolean);
+  let row = advisorRow(entry, false, plain);
+  assert.equal(lines(row).length, 1);
+  assert.deepEqual(row.handleMouse?.(click), { handled: true });
+  assert.equal(lines(row).length, 2);
+  // Drawn again (a resize) under the same Ctrl+O state: the click holds.
+  row = advisorRow(entry, false, plain);
+  assert.equal(lines(row).length, 2);
+  // Ctrl+O opens every row, then closes every row, this one included.
+  assert.equal(lines(advisorRow(entry, true, plain)).length, 2);
+  assert.equal(lines(advisorRow(entry, false, plain)).length, 1);
+});
+
+test("the advisor row is painted as a tool row: its dot, title and details, faded as tool rows are", () => {
+  const tags = { fg: (color: string, text: string) => `<${color}>${text}</>`, bold: (text: string) => `<b>${text}</b>` };
+  const reviewed = { label: "Fable", outcome: { kind: "reviewed" as const, text: "Drain first." } };
+  // compact-tools' " ⦁ Bash(ls)": a success dot, the name bold in toolTitle, the rest in toolOutput.
+  assert.deepEqual(advisorLines(reviewed, true, tags), [
+    " <success>⦁</> <toolTitle><b>Advisor</b></><toolOutput> (Fable) reviewed the conversation</>",
+    " <dim>   ⎿  </><toolOutput>Drain first.</>",
+  ]);
+  const failed = { label: "Fable", outcome: { kind: "unavailable" as const, errorCode: "overloaded" } };
+  assert.equal(advisorLines(failed, false, tags)[0], " <error>⦁</> <toolTitle><b>Advisor</b></><toolOutput> unavailable (overloaded)</>");
+  // With tool-rows-faint loaded, each line goes through its fade.
+  const key = Symbol.for("pi-extension-tool-rows-faint");
+  const shared = globalThis as Record<symbol, unknown>;
+  shared[key] = { line: (_theme: unknown, text: string) => `~${text}~` };
+  try {
+    assert.ok(advisorLines(reviewed, true, tags).every((line) => line.startsWith("~") && line.endsWith("~")));
+  } finally {
+    delete shared[key];
+  }
+});
