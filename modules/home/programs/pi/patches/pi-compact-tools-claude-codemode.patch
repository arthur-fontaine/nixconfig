diff --git a/tests/claude-codemode.test.ts b/tests/claude-codemode.test.ts
new file mode 100644
index 0000000..32892d1
--- /dev/null
+++ b/tests/claude-codemode.test.ts
@@ -0,0 +1,41 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+import { claudeAuthorBody } from "../extensions/compact-tools-claude.ts";
+import { claudeRows, claudeScriptOutput } from "../extensions/compact-tools-layout.ts";
+
+const paint = { gutter: "│ ", line: (row: string) => row, more: (hidden: number) => `… +${hidden} lines`, empty: "(No output)" };
+const plain = (row: string) => row.replace(/\x1b\[[\d;]*m/g, "");
+const done = { render: () => ["      Done in 1.8s (9 lines) · bash 1"], invalidate() {} };
+
+test("a script's output: two lines each cut to the row, then how many more, then the stats", () => {
+	const minified = "function f0(a,b){return a._isRetryableError(b)}".repeat(20);
+	const output = ["core/agent-session.js", minified, "871-        return false;", "a", "b"].join("\n");
+	const rows = claudeScriptOutput(output, "   ⎿  ", "      ", 2, paint, done).render(60).map(plain);
+	assert.deepEqual(rows, [
+		"   ⎿  │ core/agent-session.js",
+		`      │ ${minified.slice(0, 51)}…`,
+		"      │ … +3 lines",
+		"      Done in 1.8s (9 lines) · bash 1",
+	]);
+	assert.ok(rows.every((row) => row.length <= 60));
+});
+
+test("opened, a script's output is whole, wrapped behind its rail", () => {
+	const rows = claudeScriptOutput("x".repeat(70) + "\nend", "   ⎿  ", "      ", undefined, paint).render(60);
+	assert.deepEqual(rows, ["   ⎿  │ " + "x".repeat(52), "      │ " + "x".repeat(18), "      │ end"]);
+});
+
+test("a script without output says so on the rail", () => {
+	assert.deepEqual(claudeScriptOutput("", "   ⎿  ", "      ", 2, paint, done).render(60), ["   ⎿  (No output)", "      Done in 1.8s (9 lines) · bash 1"]);
+});
+
+test("a row's completion comes after the output's hidden count, not between output and count", () => {
+	const rows = claudeRows(["1", "2", "3", "4", "5"], "   ⎿  ", "      ", 3, (hidden) => `… +${hidden} lines`, done).render(60);
+	assert.deepEqual(rows.slice(-2), ["      … +2 lines", "      Done in 1.8s (9 lines) · bash 1"]);
+});
+
+test("an opened codemode row keeps its own layout rather than the tool's result view", () => {
+	assert.equal(claudeAuthorBody("codemode", true, true), false);
+	assert.equal(claudeAuthorBody("web_search", true, true), true);
+	assert.equal(claudeAuthorBody("web_search", false, true), false);
+});
