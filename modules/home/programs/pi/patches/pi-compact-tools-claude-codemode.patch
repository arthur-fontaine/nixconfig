+
+/**
+ * A codemode script's output under the calls it made: each row behind `paint.gutter`, at most
+ * `maxLines` lines each cut to the row (a minified line would wrap over several), then how many
+ * lines are left, then `completion`. Opened (`maxLines` undefined): every line, wrapped.
+ */
+export function claudeScriptOutput(
+	output: string,
+	firstPrefix: string,
+	continuationPrefix: string,
+	maxLines: number | undefined,
+	paint: ScriptOutputPaint,
+	completion?: Component,
+): Component {
+	const normalized = normalizeLineEndings(output).trimEnd();
+	const lines = !normalized || normalized === "(no output)" ? [] : normalized.split("\n");
+	const prefixWidth = Math.max(visibleWidth(firstPrefix), visibleWidth(continuationPrefix));
+	return new CachedComponent((width) => {
+		const room = Math.max(1, width - prefixWidth - visibleWidth(paint.gutter));
+		const shown = maxLines === undefined ? lines : lines.slice(0, maxLines);
+		const rows = maxLines === undefined
+			? shown.flatMap((line) => hardWrapTextWithAnsi(line, room).map((row) => paint.gutter + paint.line(row.trimEnd())))
+			: shown.map((line) => paint.gutter + paint.line(truncateToWidth(line.replace(/\t/g, "   "), room, "…")));
+		const hidden = lines.length - shown.length;
+		if (hidden > 0) rows.push(paint.gutter + truncateToWidth(paint.more(hidden), room, "…"));
+		if (!lines.length) rows.push(paint.empty);
+		const rendered = rows.map((row, index) => `${index === 0 ? firstPrefix : continuationPrefix}${row}`);
+		if (completion) rendered.push(...completion.render(width));
 		return rendered;
 	}, () => completion?.invalidate());
