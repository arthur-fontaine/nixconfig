+// `claude auth status` starts all of Claude Code (seconds), and Pi asks for it once per
+// caller at startup. Concurrent asks share one process, and the last logged-in answer is
+// kept on disk: it answers at once, and past an hour a check runs in the background for
+// the next ask. A logout shows within that hour, or at the first request Claude refuses.
+const STATUS_MAX_AGE_MS = 24 * 60 * 60 * 1_000;
+const STATUS_REFRESH_MS = 60 * 60 * 1_000;
+const STATUS_RECHECK_MS = 60_000;
+const statusChecks = new Map<string, Promise<ClaudeStatus>>();
+const statusCheckedAt = new Map<string, number>();
+
+function statusCacheFile(env: Record<string, string>): string {
+  const agentDir = env.PI_CODING_AGENT_DIR || join(env.HOME || homedir(), ".pi", "agent");
+  return join(agentDir, "cache", "claude-code-status.json");
+}
+
+function readStatusCache(file: string): Record<string, { at: number; status: ClaudeStatus }> {
+  try {
+    return JSON.parse(readFileSync(file, "utf8"));
+  } catch {
+    return {};
+  }
+}
+
+function writeStatusCache(file: string, key: string, status: ClaudeStatus): void {
+  try {
+    const all = readStatusCache(file);
+    if (status.loggedIn) all[key] = { at: Date.now(), status };
+    else delete all[key];
+    mkdirSync(dirname(file), { recursive: true });
+    writeFileSync(`${file}.${process.pid}`, JSON.stringify(all));
+    renameSync(`${file}.${process.pid}`, file);
+  } catch {}
+}
+
+function checkStatus(key: string, command: string, env: Record<string, string>): Promise<ClaudeStatus> {
+  let check = statusChecks.get(key);
+  if (!check) {
+    statusCheckedAt.set(key, Date.now());
+    check = probeClaudeStatus(command, env).then((status) => {
+      writeStatusCache(statusCacheFile(env), key, status);
+      return status;
+    });
+    check.finally(() => statusChecks.delete(key)).catch(() => {});
+    statusChecks.set(key, check);
+  }
+  return check;
+}
+
+function abortable<T>(promise: Promise<T>, signal?: AbortSignal): Promise<T> {
+  if (!signal) return promise;
+  signal.throwIfAborted();
+  return new Promise((resolvePromise, reject) => {
+    const abort = () => reject(signal.reason);
+    signal.addEventListener("abort", abort, { once: true });
+    promise.then(resolvePromise, reject).finally(() => signal.removeEventListener("abort", abort));
+  });
+}
