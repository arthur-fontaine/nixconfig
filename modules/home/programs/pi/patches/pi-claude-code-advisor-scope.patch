+// Advisor calls that already have a row. Module-wide: every extension instance (a reloaded one,
+// a subagent's) shares the listeners, and a block can be streamed to more than one of them.
+const shown = new Set<string>();
+
+export interface AdvisorRowSink {
+  /** The session this extension instance writes to. */
+  sessionId(): string | undefined;
+  label(): string;
+  setWorking(text?: string): void;
+  append(data: { id: string; label: string; outcome: AdvisorOutcome }): void;
+}
+
+/**
+ * The listener that turns advisor events into Claude Code's "Advising" line and one row per
+ * advisor call, only for calls made by this session's own turns: a subagent's go to its own
+ * session, and a request of no session (none should carry the advisor) adds none.
+ */
+export function advisorRows(sink: AdvisorRowSink): (event: AdvisorEvent) => void {
+  return (event) => {
+    if (!event.sessionId || event.sessionId !== sink.sessionId()) return;
+    const label = sink.label();
+    if (event.phase === "start") {
+      sink.setWorking(`Advising (${label})…`);
+      return;
+    }
+    sink.setWorking();
+    if (shown.has(event.id)) return;
+    shown.add(event.id);
+    if (shown.size > 1_000) shown.delete(shown.values().next().value!);
+    sink.append({ id: event.id, label, outcome: event.outcome });
+  };
+}
