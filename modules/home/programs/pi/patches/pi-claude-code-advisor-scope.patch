+/**
+ * The advisor for one request, or undefined. Claude Code attaches it to its agent loops' turns,
+ * the main thread's and its subagents', and not to its side queries (a memory line, titles).
+ * In Pi the matching signal is `onPayload`: Pi's Agent passes that hook with every turn of a
+ * session's loop (the main session's and a subagent's), while extensions' side calls through
+ * ctx.modelRegistry (auto-mode's classifier, bash-titles, auto-compact, the cache-warmer's ping)
+ * and Pi's own compaction summary don't. Guessing from the system prompt would break with any
+ * new side caller. Without it a classifier, which has no other tool, could call Fable and draw
+ * an Advisor row into the session. Dropping the tool costs no prompt-cache hits: the API keeps
+ * it out of the cache key.
+ */
+export function advisorFor(options: { onPayload?: unknown } | undefined): string | undefined {
+  return typeof options?.onPayload === "function" ? advisorModel() : undefined;
+}
