diff --git a/tests/advisor-scope.test.ts b/tests/advisor-scope.test.ts
new file mode 100644
index 0000000..c372cd7
--- /dev/null
+++ b/tests/advisor-scope.test.ts
@@ -0,0 +1,86 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+import { advisorBlock, advisorFor, advisorRows, onAdvisor, setAdvisorSource, type AdvisorEvent } from "../src/advisor.ts";
+
+const use = (id: string) => ({ type: "server_tool_use", id, name: "advisor", input: {} }) as never;
+const result = (id: string) =>
+  ({ type: "advisor_tool_result", tool_use_id: id, content: { type: "advisor_redacted_result", encrypted_content: "x" } }) as never;
+
+test("only an agent loop's own request carries the advisor, not a side request", () => {
+  setAdvisorSource(() => "fable");
+  try {
+    // Pi's Agent passes its onPayload hook with every turn of a session's loop.
+    assert.equal(advisorFor({ onPayload: () => undefined, sessionId: "main" }), "fable");
+    // ctx.modelRegistry.streamSimple / completeSimple callers (classifier, titles, summaries) don't.
+    assert.equal(advisorFor({ maxTokens: 64 }), undefined);
+    assert.equal(advisorFor({ sessionId: "main", maxTokens: 1 }), undefined);
+    assert.equal(advisorFor(undefined), undefined);
+    setAdvisorSource(() => "off");
+    assert.equal(advisorFor({ onPayload: () => undefined }), undefined);
+  } finally {
+    setAdvisorSource(() => undefined);
+  }
+});
+
+function rowsFor(session: string) {
+  const appended: unknown[] = [];
+  const working: Array<string | undefined> = [];
+  const listener = advisorRows({
+    sessionId: () => session,
+    label: () => "Fable",
+    setWorking: (text) => working.push(text),
+    append: (data) => appended.push(data),
+  });
+  return { appended, working, listener };
+}
+
+test("an advisor call adds one row, in the session whose turn made it", () => {
+  const main = rowsFor("main");
+  const sub = rowsFor("sub");
+  const offs = [onAdvisor(main.listener), onAdvisor(sub.listener)];
+  try {
+    advisorBlock(use("srvtoolu_main"), "main");
+    advisorBlock(result("srvtoolu_main"), "main");
+    advisorBlock(use("srvtoolu_sub"), "sub");
+    advisorBlock(result("srvtoolu_sub"), "sub");
+  } finally {
+    offs.forEach((off) => off());
+  }
+  assert.deepEqual(main.appended, [{ id: "srvtoolu_main", label: "Fable", outcome: { kind: "reviewed", encrypted: true } }]);
+  assert.deepEqual(main.working, ["Advising (Fable)…", undefined]);
+  assert.deepEqual(sub.appended, [{ id: "srvtoolu_sub", label: "Fable", outcome: { kind: "reviewed", encrypted: true } }]);
+});
+
+test("an advisor block from a request of no session adds no row", () => {
+  const main = rowsFor("main");
+  const off = onAdvisor(main.listener);
+  try {
+    advisorBlock(use("srvtoolu_side"));
+    advisorBlock(result("srvtoolu_side"));
+  } finally {
+    off();
+  }
+  assert.deepEqual(main.appended, []);
+  assert.deepEqual(main.working, []);
+});
+
+test("the same advisor call seen twice is one row", () => {
+  const main = rowsFor("main");
+  const again = rowsFor("main"); // a second instance for the session, as after a reload
+  const offs = [onAdvisor(main.listener), onAdvisor(again.listener)];
+  try {
+    advisorBlock(result("srvtoolu_dup"), "main");
+    advisorBlock(result("srvtoolu_dup"), "main");
+  } finally {
+    offs.forEach((off) => off());
+  }
+  assert.equal(main.appended.length + again.appended.length, 1);
+});
+
+test("events carry the request's session when one is given", () => {
+  const events: AdvisorEvent[] = [];
+  const off = onAdvisor((event) => events.push(event));
+  advisorBlock(use("a"), "s1");
+  off();
+  assert.deepEqual(events, [{ phase: "start", id: "a", sessionId: "s1" }]);
+});
