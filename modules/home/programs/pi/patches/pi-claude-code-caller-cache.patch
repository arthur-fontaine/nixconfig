+function hasCacheControl(blocks: unknown[]): boolean {
+  return blocks.some((block) => block !== null && typeof block === "object" && "cache_control" in block);
+}
+
+// The caller placed its own prompt-cache breakpoints on the user content (Claude Code's
+// auto-mode classifier does: the end of the history and the action under review). Claude
+// Code adds its own on the system prompt and its trailing environment message, which would
+// exceed the API's four, so keep one at the end of the system prompt and the caller's.
+export function keepCallerCacheBreakpoints(body: Buffer, canonicalContent: unknown[]): Buffer {
+  const payload = JSON.parse(body.toString("utf8")) as { messages?: NativeRequestMessage[]; system?: unknown };
+  normalizeLeadingSystemCache(payload.system);
+  for (const message of payload.messages ?? []) message.content = withoutCacheControl(message.content) as never;
+  const first = payload.messages?.find((message) => message.role === "user");
+  if (first && Array.isArray(first.content) && first.content.length >= canonicalContent.length) {
+    const offset = first.content.length - canonicalContent.length;
+    canonicalContent.forEach((block, index) => {
+      const marker = (block as Record<string, unknown>).cache_control;
+      const target = first.content[offset + index];
+      if (marker !== undefined && target && typeof target === "object") (target as Record<string, unknown>).cache_control = marker;
+    });
+  }
+  return Buffer.from(JSON.stringify(payload));
+}
