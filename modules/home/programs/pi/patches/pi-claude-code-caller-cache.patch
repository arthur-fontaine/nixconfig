+// Claude Code's own updater rewrites its binary in place; a spawn in that window fails with
+// ENOEXEC (half-written file), ETXTBSY or ENOENT. Waiting until the process really started,
+// and trying again a few times, rides out the reinstall instead of failing the turn.
+const RESPAWN_CODES = new Set(["ENOEXEC", "ETXTBSY", "ENOENT", "EACCES"]);
+
+async function spawnStarted(
+  command: string,
+  args: string[],
+  options: Parameters<typeof spawn>[2],
+): Promise<ChildProcess> {
+  for (let attempt = 0; ; attempt++) {
+    let failure: NodeJS.ErrnoException | null;
+    let child: ChildProcess | undefined;
+    try {
+      // ENOEXEC is thrown right away on macOS; other failures come as an "error" event.
+      child = spawnCommand(command, args, options);
+      const started = child;
+      failure = await new Promise<NodeJS.ErrnoException | null>((resolve) => {
+        started.once("spawn", () => resolve(null));
+        started.once("error", (error: NodeJS.ErrnoException) => resolve(error));
+      });
+    } catch (error) {
+      failure = error as NodeJS.ErrnoException;
+    }
+    if (!failure && child) return child;
+    if (attempt >= 6 || !RESPAWN_CODES.has(failure.code ?? "")) throw failure;
+    await new Promise((resolve) => setTimeout(resolve, 500));
+  }
+}
