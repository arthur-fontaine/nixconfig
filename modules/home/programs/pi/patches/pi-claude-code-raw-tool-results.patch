+/**
+ * Claude Code sends the tool result of the turn it is asked about trimmed, with one newline
+ * after it, but the same result replayed in the history of the next request as Pi has it. The
+ * two differ whenever the output has leading or trailing whitespace, which voids the prompt
+ * cache from that result on, and from the system prompt on when a turn of many tool calls puts
+ * it out of the API's 20-block lookback. Every text result is sent as Pi has it.
+ */
+type ResultBlock = { type?: string; tool_use_id?: unknown; content?: unknown };
+
+export function restoreToolResults(body: Buffer, frames: NativeFrame[]): Buffer {
+  const kept = new Map<string, string>();
+  for (const frame of frames) {
+    if (frame.type !== "user") continue;
+    for (const block of frame.message.content as ResultBlock[]) {
+      if (block?.type === "tool_result" && typeof block.content === "string") kept.set(String(block.tool_use_id), block.content);
+    }
+  }
+  if (!kept.size) return body;
+  const payload = JSON.parse(body.toString("utf8")) as { messages?: NativeRequestMessage[] };
+  let changed = false;
+  for (const message of payload.messages ?? []) {
+    if (message.role !== "user" || !Array.isArray(message.content)) continue;
+    for (const block of message.content as ResultBlock[]) {
+      if (block?.type !== "tool_result" || typeof block.content !== "string") continue;
+      const raw = kept.get(String(block.tool_use_id));
+      if (raw === undefined || raw === block.content) continue;
+      block.content = raw;
+      changed = true;
+    }
+  }
+  return changed ? Buffer.from(JSON.stringify(payload)) : body;
+}
