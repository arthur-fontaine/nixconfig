+test("sends every text tool result as Pi has it, so the cached prefix stays the same", () => {
+  const frames = [
+    { type: "user" as const, message: { role: "user" as const, content: [{ type: "text", text: "go" }] } },
+    { type: "assistant" as const, message: { role: "assistant" as const, content: [{ type: "tool_use", id: "t1", name: "bash", input: {} }] } },
+    { type: "user" as const, message: { role: "user" as const, content: [{ type: "tool_result", tool_use_id: "t1", content: "     300 nums.txt\n" }] } },
+  ];
+  // Claude Code's own rendering of the turn's result: trimmed, one newline.
+  const body = Buffer.from(JSON.stringify({
+    messages: [
+      { role: "user", content: [{ type: "text", text: "go" }] },
+      { role: "assistant", content: [{ type: "tool_use", id: "t1", name: "mcp__pi__bash", input: {} }] },
+      { role: "user", content: [{ type: "tool_result", tool_use_id: "t1", content: "300 nums.txt\n", cache_control: { type: "ephemeral" } }] },
+    ],
+  }));
+  const out = JSON.parse(restoreToolResults(body, frames).toString("utf8"));
+  assert.deepEqual(out.messages[2].content[0], { type: "tool_result", tool_use_id: "t1", content: "     300 nums.txt\n", cache_control: { type: "ephemeral" } });
+  // Already as Pi has it: the very same body.
+  const raw = Buffer.from(JSON.stringify(out));
+  assert.equal(restoreToolResults(raw, frames), raw);
 });
 
