diff --git a/tests/relay-failure.test.ts b/tests/relay-failure.test.ts
new file mode 100644
index 0000000..7770d1a
--- /dev/null
+++ b/tests/relay-failure.test.ts
@@ -0,0 +1,269 @@
+import assert from "node:assert/strict";
+import * as http from "node:http";
+import { chmod, mkdtemp, realpath, rm, writeFile } from "node:fs/promises";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import test from "node:test";
+import { isRetryableAssistantError, type AssistantMessage } from "@earendil-works/pi-ai";
+import { closeClaudeProcesses, runClaudeRequest } from "../src/claude-cli.ts";
+import { normalizeError } from "../src/stream.ts";
+import { TurnRelay } from "../src/turn-relay.ts";
+
+function failedMessage(errorMessage: string): AssistantMessage {
+  return {
+    role: "assistant",
+    content: [],
+    api: "claude-code-stream-json",
+    provider: "claude-code",
+    model: "sonnet",
+    usage: {
+      input: 0,
+      output: 0,
+      cacheRead: 0,
+      cacheWrite: 0,
+      totalTokens: 0,
+      cost: { input: 0, output: 0, cacheRead: 0, cacheWrite: 0, total: 0 },
+    },
+    stopReason: "error",
+    errorMessage,
+    timestamp: 0,
+  };
+}
+
+const retryable = (message: string) => isRetryableAssistantError(failedMessage(normalizeError(new Error(message))));
+
+function listen(server: http.Server): Promise<number> {
+  return new Promise((resolve) => {
+    server.listen(0, "127.0.0.1", () => {
+      const address = server.address();
+      if (!address || typeof address === "string") throw new Error("missing address");
+      resolve(address.port);
+    });
+  });
+}
+
+const usage = { input_tokens: 3, output_tokens: 1, cache_read_input_tokens: 0, cache_creation_input_tokens: 0 };
+const sse = (events: unknown[]) => events.map((event) => "data: " + JSON.stringify(event) + "\n\n").join("");
+// A cut turn that had begun a tool call: Pi must never get that call to run.
+const partialEvents = [
+  { type: "message_start", message: { id: "m_cut", role: "assistant", content: [], usage } },
+  { type: "content_block_start", index: 0, content_block: { type: "text", text: "" } },
+  { type: "content_block_delta", index: 0, delta: { type: "text_delta", text: "Let me look" } },
+  { type: "content_block_stop", index: 0 },
+  { type: "content_block_start", index: 1, content_block: { type: "tool_use", id: "toolu_cut", name: "mcp__pi__bash", input: {} } },
+  { type: "content_block_delta", index: 1, delta: { type: "input_json_delta", partial_json: '{"command":"ec' } },
+];
+const fullEvents = [
+  { type: "message_start", message: { id: "m_ok", role: "assistant", content: [], usage } },
+  { type: "content_block_start", index: 0, content_block: { type: "text", text: "" } },
+  { type: "content_block_delta", index: 0, delta: { type: "text_delta", text: "done" } },
+  { type: "content_block_stop", index: 0 },
+  { type: "message_delta", delta: { stop_reason: "end_turn" }, usage },
+  { type: "message_stop" },
+];
+
+type Mode = "cut-200" | "cut-400" | "400" | "429" | "ok";
+
+/** Loopback Anthropic upstream; each request takes the next mode. */
+async function upstreamFixture(modes: Mode[]) {
+  const bodies: string[] = [];
+  const server = http.createServer(async (request, response) => {
+    let body = "";
+    for await (const chunk of request) body += chunk;
+    bodies.push(body);
+    const mode = modes.shift() ?? "ok";
+    if (mode === "cut-200") {
+      response.writeHead(200, { "content-type": "text/event-stream", "request-id": "req_cut" });
+      response.write(sse(partialEvents));
+      setTimeout(() => response.socket?.destroy(), 50);
+    } else if (mode === "cut-400") {
+      response.writeHead(400, { "content-type": "application/json" });
+      response.write('{"type":"error","error":{"type":"invalid_request_error","message":"bad req');
+      setTimeout(() => response.socket?.destroy(), 50);
+    } else if (mode === "400") {
+      response.writeHead(400, { "content-type": "application/json" });
+      response.end(JSON.stringify({ type: "error", error: { type: "invalid_request_error", message: "messages: text content blocks must be non-empty" } }));
+    } else if (mode === "429") {
+      response.writeHead(429, { "content-type": "application/json" });
+      response.end(JSON.stringify({ type: "error", error: { type: "rate_limit_error", message: "Number of request tokens has exceeded your per-minute rate limit" } }));
+    } else {
+      response.writeHead(200, { "content-type": "text/event-stream" });
+      response.end(sse(fullEvents));
+    }
+  });
+  const port = await listen(server);
+  return { url: "http://127.0.0.1:" + port, bodies, close: () => new Promise<void>((resolve) => server.close(() => resolve())) };
+}
+
+// Behaves like Claude Code against a turn relay: one POST, and on a failed
+// response two more attempts before giving up with an API error and a result.
+const fakeClaude = String.raw`#!/usr/bin/env node
+import readline from "node:readline";
+if (process.argv.includes("auth") && process.argv.includes("status")) {
+  console.log(JSON.stringify({loggedIn: true, authMethod: "claude.ai", subscriptionType: "max"}));
+  process.exit(0);
+}
+const input = readline.createInterface({input: process.stdin, crlfDelay: Infinity});
+for await (const line of input) {
+  const frame = JSON.parse(line);
+  if (frame.type !== "user" || frame.shouldQuery === false) continue;
+  const body = JSON.stringify({model: "claude-sonnet-5", stream: true, messages: [{role: "user", content: frame.message.content}]});
+  let ok = false;
+  for (let attempt = 0; attempt < 3 && !ok; attempt++) {
+    try {
+      const response = await fetch(process.env.ANTHROPIC_BASE_URL + "/v1/messages", {method: "POST", body});
+      // The relay ends a cut body like a whole one; Claude Code spots it by the missing message_stop.
+      ok = response.status === 200 && (await response.text()).includes("message_stop");
+    } catch {}
+  }
+  const usage = {input_tokens: 3, output_tokens: 1};
+  if (!ok) {
+    console.log(JSON.stringify({type: "assistant", error: "unknown", message: {id: "e", role: "assistant", content: [{type: "text", text: "API Error: Connection error."}], usage}}));
+    console.log(JSON.stringify({type: "result", subtype: "success", is_error: true, usage}));
+  } else {
+    console.log(JSON.stringify({type: "result", subtype: "success", is_error: false, usage}));
+  }
+}
+`;
+
+async function withFakeClaude(run: (request: (upstreamUrl: string) => Promise<unknown>) => Promise<void>) {
+  const root = await realpath(await mkdtemp(join(tmpdir(), "pi-claude-code-relay-failure-")));
+  const executable = join(root, "fake-claude.mjs");
+  await writeFile(executable, fakeClaude, "utf8");
+  await chmod(executable, 0o755);
+  const request = (upstreamUrl: string) =>
+    runClaudeRequest({
+      model: "sonnet",
+      cwd: root,
+      frames: [{ type: "user", message: { role: "user", content: [{ type: "text", text: "run the probe" }] } }],
+      systemPrompt: "system",
+      manifest: [],
+      extraBody: { tools: [] },
+      toolNames: new Set(["bash"]),
+      env: { PI_CLAUDE_CODE_COMMAND: executable, PI_CLAUDE_CODE_UPSTREAM_URL: upstreamUrl },
+      timeoutMs: 10_000,
+    });
+  try {
+    await run(request);
+  } finally {
+    await closeClaudeProcesses();
+    await rm(root, { recursive: true, force: true });
+  }
+}
+
+test("a 200 stream the upstream cuts names its cause and is retried by Pi, without running the cut tool call", async () => {
+  const upstream = await upstreamFixture(["cut-200", "ok"]);
+  try {
+    await withFakeClaude(async (request) => {
+      let cut = "";
+      await assert.rejects(request(upstream.url), (error: Error) => {
+        cut = error.message;
+        return true;
+      });
+      assert.match(cut, /^Incomplete Claude Code upstream response/);
+      assert.match(cut, /status 200/);
+      assert.match(cut, /native retries denied 2/);
+      // Who broke the stream: the upstream socket, reset under the relay.
+      assert.match(cut, /upstream/);
+      assert.match(cut, /ECONNRESET/);
+      assert.match(cut, /aborted/);
+      assert.equal(retryable(cut), true, cut);
+
+      // Pi's retry: a fresh Claude Code replays the same frames, so the user
+      // message goes up once and the cut tool call is nowhere in the request.
+      const retried = (await request(upstream.url)) as { message: { content: Array<{ type: string; text?: string }> } };
+      assert.equal(retried.message.content[0]?.text, "done");
+      assert.equal(upstream.bodies.length, 2);
+      const replay = upstream.bodies[1]!;
+      assert.equal(replay.split("run the probe").length - 1, 1);
+      assert.doesNotMatch(replay, /toolu_cut|tool_use/);
+    });
+  } finally {
+    await upstream.close();
+  }
+});
+
+test("4xx answers keep their retryability", async () => {
+  const upstream = await upstreamFixture(["400", "429", "cut-400"]);
+  try {
+    await withFakeClaude(async (request) => {
+      const messages: string[] = [];
+      for (let i = 0; i < 3; i++) {
+        await assert.rejects(request(upstream.url), (error: Error) => {
+          messages.push(error.message);
+          return true;
+        });
+      }
+      const [badRequest, rateLimited, cutBadRequest] = messages as [string, string, string];
+      assert.match(badRequest, /status 400.*upstream said: messages: text content blocks must be non-empty/);
+      assert.equal(retryable(badRequest), false, badRequest);
+      assert.match(rateLimited, /status 429.*upstream said: Number of request tokens/);
+      assert.equal(retryable(rateLimited), true, rateLimited);
+      // A 400 whose body was cut is still a 400: the cause is shown, not retried.
+      assert.match(cutBadRequest, /status 400/);
+      assert.match(cutBadRequest, /ECONNRESET/);
+      assert.equal(retryable(cutBadRequest), false, cutBadRequest);
+      assert.doesNotMatch(cutBadRequest, /stream was interrupted/);
+    });
+  } finally {
+    await upstream.close();
+  }
+});
+
+test("usage-credit rejections stay non-retryable even when their stream was cut", () => {
+  const message = normalizeError(
+    new Error("Incomplete Claude Code upstream response: stream was interrupted (status 400, upstream said: You're out of extra usage. Add more at claude.ai/settings/usage and keep going.)"),
+  );
+  assert.match(message, /^Claude Code billing:/);
+  assert.equal(isRetryableAssistantError(failedMessage(message)), false);
+});
+
+test("the relay names Claude Code when it hangs up mid-stream", async () => {
+  let streaming: NodeJS.Timeout | undefined;
+  const upstream = http.createServer(async (request, response) => {
+    for await (const _chunk of request);
+    response.writeHead(200, { "content-type": "text/event-stream" });
+    response.write(sse(partialEvents.slice(0, 1)));
+    const ping = sse([{ type: "ping" }]).repeat(2_000);
+    streaming = setInterval(() => response.write(ping), 10);
+    response.on("close", () => clearInterval(streaming));
+  });
+  const port = await listen(upstream);
+  const relay = new TurnRelay("http://127.0.0.1:" + port, 5_000);
+  try {
+    const baseUrl = await relay.start();
+    const controller = new AbortController();
+    const response = await fetch(baseUrl + "/v1/messages", { method: "POST", body: "{}", signal: controller.signal });
+    const reader = response.body!.getReader();
+    await reader.read();
+    controller.abort();
+    const settled = await Promise.race([
+      relay.settled().then(() => true),
+      new Promise<boolean>((resolve) => setTimeout(() => resolve(false), 2_000)),
+    ]);
+    assert.equal(settled, true, "relay still pumping after Claude Code hung up");
+    assert.match(relay.failure ?? "", /^Claude Code .*disconnected/);
+  } finally {
+    clearInterval(streaming);
+    await relay.close();
+    upstream.closeAllConnections();
+    await new Promise<void>((resolve) => upstream.close(() => resolve()));
+  }
+});
+
+test("the relay records why a 200 stream broke", async () => {
+  const upstream = await upstreamFixture(["cut-200"]);
+  const relay = new TurnRelay(upstream.url, 5_000);
+  try {
+    const baseUrl = await relay.start();
+    const response = await fetch(baseUrl + "/v1/messages", { method: "POST", body: "{}" });
+    assert.equal(response.status, 200);
+    await response.text().catch(() => undefined);
+    await relay.settled();
+    assert.equal(relay.capture.complete, false);
+    assert.match(relay.failure ?? "", /^upstream .*ECONNRESET.*aborted/);
+  } finally {
+    await relay.close();
+    await upstream.close();
+  }
+});
