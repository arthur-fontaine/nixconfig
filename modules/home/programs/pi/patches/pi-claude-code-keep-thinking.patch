+test("puts back the signed thinking Claude Code leaves out of replayed turns", () => {
+  const thinking = { type: "thinking", thinking: "", signature: "sig" };
+  const frames = [
+    { type: "user" as const, message: { role: "user" as const, content: [{ type: "text", text: "go" }] } },
+    { type: "assistant" as const, message: { role: "assistant" as const, content: [thinking, { type: "tool_use", id: "t1", name: "bash", input: {} }] } },
+    { type: "assistant" as const, message: { role: "assistant" as const, content: [{ type: "text", text: "plain" }] } },
+  ];
+  const body = Buffer.from(JSON.stringify({
+    messages: [
+      { role: "user", content: [{ type: "text", text: "go" }] },
+      { role: "assistant", content: [{ type: "tool_use", id: "t1", name: "mcp__pi__bash", input: {} }] },
+      { role: "user", content: [{ type: "tool_result", tool_use_id: "t1", content: "ok" }] },
+      { role: "assistant", content: [{ type: "text", text: "plain" }] },
+    ],
+  }));
+  const out = JSON.parse(restoreThinking(body, frames).toString("utf8"));
+  assert.deepEqual(out.messages[1].content.map((b: { type: string }) => b.type), ["thinking", "tool_use"]);
+  assert.deepEqual(out.messages[1].content[0], thinking);
+  assert.deepEqual(out.messages[3].content, [{ type: "text", text: "plain" }]);
+  // Nothing to restore: the very same body.
+  assert.equal(restoreThinking(body, frames.slice(0, 1)), body);
 });
