+type Block = { type?: string; id?: unknown; text?: unknown };
+const isThinking = (block: Block) => block?.type === "thinking" || block?.type === "redacted_thinking";
+
+// What identifies an assistant turn in both Pi's frames and Claude Code's request: its tool
+// calls' ids, else its text.
+function turnKey(content: unknown): string | undefined {
+  if (!Array.isArray(content)) return undefined;
+  const blocks = content as Block[];
+  const ids = blocks.filter((b) => b?.type === "tool_use").map((b) => String(b.id));
+  if (ids.length) return `tools:${ids.join(",")}`;
+  const text = blocks.filter((b) => b?.type === "text").map((b) => String(b.text ?? "")).join("").trim();
+  return text ? `text:${text}` : undefined;
+}
+
+/**
+ * Claude Code leaves out the signed thinking of the assistant turns Pi replays to it (Claude's
+ * thinking reaches Pi with an empty text and only its signature), so the model saw none of its
+ * earlier reasoning and planned from scratch at every tool round. The thinking blocks Pi kept
+ * are put back at the head of their turn; the request asks the API to keep all thinking.
+ */
+export function restoreThinking(body: Buffer, frames: NativeFrame[]): Buffer {
+  const kept = new Map<string, unknown[]>();
+  for (const frame of frames) {
+    if (frame.type !== "assistant") continue;
+    const thinking = (frame.message.content as Block[]).filter(isThinking);
+    const key = turnKey(frame.message.content);
+    if (thinking.length && key) kept.set(key, thinking);
+  }
+  if (!kept.size) return body;
+  const payload = JSON.parse(body.toString("utf8")) as { messages?: NativeRequestMessage[] };
+  let changed = false;
+  for (const message of payload.messages ?? []) {
+    if (message.role !== "assistant" || !Array.isArray(message.content)) continue;
+    if ((message.content as Block[]).some(isThinking)) continue;
+    const thinking = kept.get(turnKey(message.content) ?? "");
+    if (!thinking) continue;
+    message.content = [...structuredClone(thinking), ...message.content];
+    changed = true;
+  }
+  return changed ? Buffer.from(JSON.stringify(payload)) : body;
+}
