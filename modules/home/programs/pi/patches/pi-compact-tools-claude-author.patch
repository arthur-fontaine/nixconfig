In the Claude style, an opened bash row whose renderer comes from another
extension (syntax-highlighting here) drew the output twice: compact-tools'
plain copy, then the author's view beneath it. Keep the author's view alone,
and the completion line that the plain copy used to carry.

diff -ru a/extensions/compact-tools.ts b/extensions/compact-tools.ts
--- a/extensions/compact-tools.ts	2026-11-03 20:01:12
+++ b/extensions/compact-tools.ts	2026-11-03 20:01:12
@@ -401,10 +401,12 @@
 	const outcome = body && rowKind(name) === "custom"
 		? formatResultLineSummary(name, args, result, output) ?? "Done"
 		: claudeOutcome(name, args, result, output, (value) => theme.bold(value));
+	// An opened command's author view (a highlighter's, say) prints the output itself: not twice.
+	const authorShell = body !== undefined && rowKind(name) === "shell";
 	if (outcome !== undefined) container.addChild(line(theme.fg("toolOutput", outcome)));
-	else container.addChild(claudeOutput(output, expanded, theme, false, rowKind(name) === "shell" ? "(No output)" : "(No content)", chrome(CLAUDE_RESULT_PREFIX), completion));
+	else if (!authorShell) container.addChild(claudeOutput(output, expanded, theme, false, rowKind(name) === "shell" ? "(No output)" : "(No content)", chrome(CLAUDE_RESULT_PREFIX), completion));
 	if (body) container.addChild(body);
-	if (completion && outcome !== undefined) container.addChild(completion);
+	if (completion && (outcome !== undefined || authorShell)) container.addChild(completion);
 	return container;
 }
 
