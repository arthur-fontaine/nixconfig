// Zed keymap
//
// For information on binding keys, see the Zed
// documentation: https://zed.dev/docs/key-bindings
//
// To see the default key bindings run `zed: open default keymap`
// from the command palette.
[
  {
    "context": "Editor",
    "bindings": {
      "cmd-backspace": "editor::DeleteLine",
    },
    "unbind": {
      "cmd-backspace": "editor::DeleteToBeginningOfLine",
    },
  },
  {
    "context": "!AcpThread > Editor && mode == full",
    "unbind": {
      "cmd-shift-e": "pane::RevealInProjectPanel",
    },
  },
  {
    "context": "!AcpThread > Editor && mode == full && vim_mode == normal",
    "bindings": {
      "space e": "pane::RevealInProjectPanel",
    },
  },
  {
    "context": "AgentPanel",
    "unbind": {
      "cmd-shift-e": "project_panel::ToggleFocus",
    },
  },
  {
    "context": "AgentPanel && vim_mode == normal",
    "bindings": {
      "space e": "project_panel::ToggleFocus",
    },
  },
  {
    "context": "Workspace",
    "unbind": {
      "cmd-shift-e": "project_panel::ToggleFocus",
    },
  },
  {
    "context": "Workspace && vim_mode == normal",
    "bindings": {
      "space e": "project_panel::ToggleFocus",
    },
  },
  {
    "unbind": {
      "cmd-o": "workspace::Open",
    },
  },
  {
    "context": "Workspace",
    "bindings": {
      "cmd-o": "editor::ShowCompletions",
    },
  },
  {
    "context": "(Editor && vim_mode == normal) || EmptyPane",
    "bindings": {
      "space g g": "git_panel::ToggleFocus",
      "space g f": "git_graph::Open",
    },
  },
  {
    "context": "GitPanel",
    "bindings": {
      "space g f": "git_graph::Open",
    },
  },
  {
    "bindings": {
      "shift shift": "file_finder::Toggle",
      "alt alt": "command_palette::Toggle",
    },
  },
  {
    "context": "Workspace",
    "unbind": {
      "cmd-shift-t": "pane::ReopenClosedItem",
    },
  },
  {
    "context": "(Workspace && vim_mode == normal) || EmptyPane",
    "bindings": {
      "space t": "terminal_panel::Toggle",
    },
  },
  {
    "context": "Editor && vim_mode == normal && !TerminalPanel",
    "bindings": {
      "space t": "terminal_panel::Toggle",
    },
  },
  {
    "context": "(Workspace && vim_mode == normal) || EmptyPane",
    "bindings": {
      "space c": "agent::ToggleFocus",
    },
  },
  {
    "context": "Editor && vim_mode == normal && !AgentPanel",
    "bindings": {
      "space c": "agent::ToggleFocus",
    },
  },
  {
    "context": "Editor",
    "bindings": {
      "cmd-enter": "vim::InsertEmptyLineBelow",
    },
    "unbind": {
      "cmd-enter": "editor::NewlineBelow",
    },
  },
]
