#!/usr/bin/env node
// A synthetic Pi session for the Info panel's shots and audit, never a real transcript.
//   info-session <dir>   writes <dir>/repo, a git repo the session's edits really happened in
//                        (its commits dated as the session goes: the base before it, one in the
//                        middle; "git diff --numstat <base>" is the lines' ground truth), and:
//     session.jsonl   the session
//     running.jsonl   the same plus one script without a result (working, or dead when idle)
//     waiting.jsonl   the same plus an ask without an answer
//     cc.jsonl        a session with Claude Code's tool names (Bash, Read, Edit, Write, …)
//     big.jsonl       440 untitled scripts, ~1 400 rows: a long real session's size
//     empty.jsonl     a session that started and made no call yet
//   <dir>/scratch holds the files it wrote outside the repo.
// Timestamps end now, so ages read as minutes. The calls the shots look at come last (the list
// is newest first); some 190 small ones go first so the list passes 200 rows (Show all).
import { execFileSync } from "node:child_process";
import { mkdirSync, writeFileSync, readFileSync, rmSync, existsSync } from "node:fs";
import { join, dirname } from "node:path";

const dir = process.argv[2];
if (!dir) { console.error("usage: info-session <dir>"); process.exit(1); }
const repo = join(dir, "repo");
rmSync(repo, { recursive: true, force: true });
mkdirSync(repo, { recursive: true });
const git = (...a) => execFileSync("git", ["-C", repo, "-c", "user.name=sandbox", "-c", "user.email=sandbox@localhost", "-c", "commit.gpgsign=false", ...a], { encoding: "utf8" });
// A commit dated at ms: author and committer (git log --before reads the committer date).
const commitAt = (ms, msg) => execFileSync("git", ["-C", repo, "-c", "user.name=sandbox", "-c", "user.email=sandbox@localhost", "-c", "commit.gpgsign=false", "commit", "-q", "-m", msg],
  { env: { ...process.env, GIT_AUTHOR_DATE: new Date(ms).toISOString(), GIT_COMMITTER_DATE: new Date(ms).toISOString() } });
const scratch = join(dir, "scratch");
rmSync(scratch, { recursive: true, force: true });
mkdirSync(scratch, { recursive: true });
const now = Date.now();

const lines = (n, f) => Array.from({ length: n }, (_, i) => f(i + 1)).join("\n") + "\n";
const BASE = {
  "README.md": "# Tide tables\n\nPredicts high and low water for a harbour from its constituents.\n\n## Usage\n\n    tide predict brest 2026-11-17\n",
  "src/parse.js": lines(40, (i) => i === 12 ? "export function parse(text) {" : i === 13 ? "  return text.split(\",\").map(Number);" : i === 14 ? "}" : "// parse " + i),
  "src/harbour.js": lines(30, (i) => i === 5 ? "const DEFAULT = \"brest\";" : "// harbour " + i),
  "src/predict.js": lines(60, (i) => "// predict " + i),
  "tests/parse.test.js": lines(20, (i) => "// test " + i),
  "docs/guide.md": lines(25, (i) => "Guide line " + i),
  "config/harbours.json": "{\n  \"brest\": { \"lat\": 48.38 },\n  \"saint-malo\": { \"lat\": 48.64 }\n}\n",
};
for (const [p, c] of Object.entries(BASE)) { mkdirSync(dirname(join(repo, p)), { recursive: true }); writeFileSync(join(repo, p), c); }
git("init", "-q", "-b", "main");
git("add", "-A");
commitAt(now - 60 * 60 * 1000, "base");

const abs = (p) => join(repo, p);
const read = (p) => (existsSync(abs(p)) ? readFileSync(abs(p), "utf8") : "");
// An edit as Pi does it, applied for real, with Pi's numbered diff ("- 13 old", "+ 13 new").
function doEdit(p, oldText, newText) {
  const before = read(p), at = before.indexOf(oldText);
  if (at < 0 || before.indexOf(oldText, at + 1) >= 0) throw new Error("edit " + p + ": not unique");
  writeFileSync(abs(p), before.slice(0, at) + newText + before.slice(at + oldText.length));
  const line = before.slice(0, at).split("\n").length;
  const out = [];
  if (line > 1) out.push("  " + (line - 1) + " " + before.split("\n")[line - 2]);
  oldText.split("\n").forEach((l, i) => out.push("- " + (line + i) + " " + l));
  newText.split("\n").forEach((l, i) => out.push("+ " + (line + i) + " " + l));
  return out.join("\n");
}
function doWrite(p, content) { const f = p.startsWith("/") ? p : abs(p); mkdirSync(dirname(f), { recursive: true }); writeFileSync(f, content); }
// What bash-changes records for a bash call: per file, git's numstat of that call's own change
// (its content before → after).
function changes(before) {
  const files = Object.entries(before).map(([p, old]) => {
    const tmp = join(dir, ".before");
    writeFileSync(tmp, old);
    let stat = "";
    try { execFileSync("git", ["diff", "--no-index", "--numstat", tmp, abs(p)], { encoding: "utf8" }); } catch (e) { stat = e.stdout; }
    rmSync(tmp);
    const [a, r] = stat.trim().split("\t");
    return { path: p, status: "M", added: Number(a), removed: Number(r) };
  });
  return { root: repo, files };
}

let t = now - 52 * 60 * 1000;
const ts = (step = 2000) => { t += step; return t; };
const iso = (ms) => new Date(ms).toISOString();
const out = [];
const put = (o) => out.push(JSON.stringify(o));
let ctx = 18000, n = 0;
const id = (p = "toolu_syn") => p + String(++n).padStart(4, "0");

function assistant(calls, { grow = 900, out: o = 180 } = {}) {
  ctx += grow;
  const cached = Math.round(ctx * 0.92), write = ctx - cached - 3;
  const at = ts(3000);
  put({ type: "message", timestamp: iso(at), message: { role: "assistant", model: "claude-opus-5-5", thinkingLevel: "high", timestamp: at,
    usage: { input: 3, cacheRead: cached, cacheWrite: write, output: o, totalTokens: 3 + cached + write + o },
    content: [{ type: "text", text: "…" }, ...calls.map((c) => ({ type: "toolCall", id: c.id, name: c.name, arguments: c.arguments }))] } });
  return at;
}
function result(c, { text = "", ms = 400, isError = false, details } = {}) {
  const at = ts(ms);
  put({ type: "message", timestamp: iso(at), message: { role: "toolResult", toolCallId: c.id, toolName: c.name, timestamp: at, durationMs: ms, isError,
    content: [{ type: "text", text }], ...(details ? { details } : {}) } });
}
function user(text) { const at = ts(20000); put({ type: "message", timestamp: iso(at), message: { role: "user", timestamp: at, content: text } }); }

// One codemode script: its nested calls (applied for real when they edit or write), as Pi
// records them in nestedCalls and details.calls. A nested call with cut: true keeps only
// argumentsBytes (its arguments were too big), as Pi does for large writes.
function script(code, nested, { title = null, ms = 3000, threw = false, record = true } = {}) {
  const c = { id: id(), name: "codemode", arguments: { code } };
  assistant([c], { grow: 1400 });
  const calls = nested.map((x, i) => ({ id: c.id + "/" + (i + 1), ...x }));
  // bash-changes records a script's changes in its repo too (as for bash): its result's fileChanges.
  const touched = {};
  const inRepo = (x) => x.arguments.path.startsWith(repo + "/");
  for (const x of calls) if ((x.name === "edit" || x.name === "write") && x.status !== "error" && inRepo(x)) touched[x.arguments.path.slice(repo.length + 1)] ??= read(x.arguments.path.slice(repo.length + 1));
  for (const x of calls) {
    if (x.status === "error") continue;
    if (x.name === "edit") doEdit(x.arguments.path.slice(repo.length + 1), x.arguments.edits[0].oldText, x.arguments.edits[0].newText);
    if (x.name === "write") doWrite(inRepo(x) ? x.arguments.path.slice(repo.length + 1) : x.arguments.path, x.arguments.content);
  }
  const nestedCalls = { complete: true, calls: calls.map((x) => ({ id: x.id, name: x.name, status: x.status ?? "ok", durationMs: x.ms ?? 120,
    ...(x.cut ? { argumentsBytes: JSON.stringify(x.arguments).length } : { arguments: x.arguments }), ...(x.error ? { error: x.error } : {}) })) };
  const details = { autoMode: false, calls: calls.map((x) => ({ id: x.id, name: x.name, status: x.status ?? "ok", durationMs: x.ms ?? 120,
    args: JSON.stringify(x.arguments).slice(0, x.cut === "nopath" ? 12 : x.cut ? 160 : 4000), ...(x.error ? { error: x.error } : {}) })),
    callOutputs: Object.fromEntries(calls.map((x) => [x.id, { lines: (x.out ?? "ok").split("\n"), total: (x.out ?? "ok").split("\n").length }])),
    ...(title ? { title } : {}), ...(record && Object.keys(touched).length ? { fileChanges: changes(touched) } : {}) };
  result(c, { text: threw ? "Error: tools.bash failed" : calls.map((x) => x.out ?? "ok").join("\n"), ms, isError: threw, details });
  // Pi's nestedCalls sits on the message itself.
  const last = JSON.parse(out.pop()); last.message.nestedCalls = nestedCalls; put(last);
  return c;
}

// ---- the session ----------------------------------------------------------------------
put({ type: "session", version: 3, id: "syn-session", cwd: repo, timestamp: iso(t) });
put({ type: "model_change", modelId: "claude-opus-5-5", provider: "anthropic", timestamp: iso(ts(10)) });
put({ type: "thinking_level_change", thinkingLevel: "high", timestamp: iso(ts(10)) });
put({ type: "session_info", name: "tide-tables-parser", timestamp: iso(ts(10)) });
user("The parser drops negative heights; fix it and add a test.");

// Filler: small direct reads and bash calls, oldest first.
const FILES = Object.keys(BASE);
for (let i = 0; i < 64; i++) {
  const calls = [
    { id: id(), name: "read", arguments: { path: abs(FILES[i % FILES.length]) } },
    { id: id(), name: "bash", arguments: { command: ["git status -sb", "ls src tests", "rg -n parse src", "node --test tests"][i % 4] } },
    { id: id(), name: "read", arguments: { path: abs(FILES[(i + 3) % FILES.length]), offset: 1, limit: 40 } },
  ];
  assistant(calls, { grow: 700 });
  for (const c of calls) result(c, { text: "…", ms: c.name === "bash" ? 300 + (i % 7) * 900 : 20 + i });
}

// A compaction: the context drops and grows again.
put({ type: "compaction", timestamp: iso(ts(5000)), summary: "(synthetic)", firstKeptEntryId: "x", tokensBefore: ctx });
ctx = 42000;
user("Go on.");

// Direct edits and writes.
{
  const c = { id: id(), name: "edit", arguments: { path: abs("src/parse.js"), edits: [{ oldText: "  return text.split(\",\").map(Number);", newText: "  return text.split(\",\").map((s) => Number(s.trim()))\n    .filter((n) => !Number.isNaN(n));" }] } };
  assistant([c]); const diff = doEdit("src/parse.js", c.arguments.edits[0].oldText, c.arguments.edits[0].newText);
  result(c, { text: "Successfully replaced 1 block", ms: 40, details: { diff } });
}
{
  const content = lines(14, (i) => "export const unit" + i + " = " + i + ";");
  const c = { id: id(), name: "write", arguments: { path: abs("src/units.js"), content } };
  assistant([c]); doWrite("src/units.js", content); result(c, { text: "Wrote 14 lines", ms: 30 });
}
{
  // An existing file rewritten whole: git sees 3 lines changed, the panel can't know the old content.
  const content = read("docs/guide.md").replace("Guide line 3\n", "Guide line three\n").replace("Guide line 9\n", "").concat("Guide line 26\n");
  const c = { id: id(), name: "write", arguments: { path: abs("docs/guide.md"), content } };
  assistant([c]); doWrite("docs/guide.md", content); result(c, { text: "Wrote 25 lines", ms: 30 });
}
{
  const c = { id: id(), name: "ask_user_question", arguments: { questions: [{ question: "Should negative heights below chart datum be kept or clamped to zero?", header: "Datum", options: [{ label: "Keep", description: "" }, { label: "Clamp", description: "" }] }] } };
  assistant([c]); result(c, { text: "User answered: Keep", ms: 41000 });
}
{
  // A long bash command, titled by its result (bash-titles), that fails.
  const command = "cd " + repo + " && export NODE_OPTIONS=--enable-source-maps; node --test tests/parse.test.js 2>&1 | tee /tmp/parse-test.log | tail -40 && grep -c FAIL /tmp/parse-test.log";
  const c = { id: id(), name: "bash", arguments: { command } };
  assistant([c]); result(c, { text: "not ok 3 - negative heights\n1", ms: 6200, isError: true, details: { title: "Runs the parser tests and counts failures" } });
}
// Script A: titled by its result, nested read, edit, write, bash.
script("const a = await tools.read({ path: \"src/parse.js\" });\nawait tools.edit({ path: \"tests/parse.test.js\", edits: [...] });\nawait tools.write({ path: \"tests/negative.test.js\", content });\nreturn await tools.bash({ command: \"node --test tests\" });", [
  { name: "read", arguments: { path: abs("src/parse.js") }, out: "// parse 1\n// parse 2" },
  { name: "edit", arguments: { path: abs("tests/parse.test.js"), edits: [{ oldText: "// test 4\n// test 5", newText: "// test 4\ntest(\"keeps negative heights\", () => {\n  assert.deepEqual(parse(\"-0.4, 1.2\"), [-0.4, 1.2]);\n});" }] } },
  { name: "write", arguments: { path: abs("tests/negative.test.js"), content: lines(12, (i) => "// negative " + i) } },
  { name: "bash", arguments: { command: "node --test tests" }, ms: 2400, out: "ok 1\nok 2\nok 3" },
], { title: "Fixes negative heights and adds their test", ms: 3100 });
// The agent commits what it has so far (git commit, as a bash call), dated now in the session.
{
  const c = { id: id(), name: "bash", arguments: { command: "git add -A && git commit -m \"fix(parse): keep negative heights\"" } };
  assistant([c]); git("add", "-A"); commitAt(t, "fix(parse): keep negative heights"); result(c, { text: "[main 1a2b3c4] fix(parse): keep negative heights", ms: 200 });
}
// Scratch files outside the repo: a direct write, and a script's (one of its writes keeps
// neither its arguments nor a readable path, and the script has no bash-changes record).
{
  const c = { id: id(), name: "write", arguments: { path: join(scratch, "probe.mjs"), content: lines(6, (i) => "// probe " + i) } };
  assistant([c]); doWrite(c.arguments.path, c.arguments.content); result(c, { text: "Wrote 6 lines", ms: 20 });
}
script("await tools.write({ path: scratchFile, content });\nawait tools.write({ path: other, content: huge });", [
  { name: "write", arguments: { path: join(scratch, "tides.csv"), content: lines(30, (i) => "brest," + i) } },
  { name: "write", cut: "nopath", arguments: { path: join(scratch, "huge.json"), content: lines(400, (i) => "{\"n\": " + i + "}") } },
], { ms: 900, record: false });
// Script B: a nested bash fails, the script catches it and goes on; titled later by a bash-titles entry.
const b = script("for (const h of [\"brest\", \"saint-malo\"]) { try { await tools.bash({ command: \"tide predict \" + h }); } catch {} }", [
  { name: "bash", arguments: { command: "tide predict brest 2026-11-17" }, ms: 900, out: "06:12 high 6.8 m" },
  { name: "bash", arguments: { command: "tide predict saint-malo 2026-11-17" }, status: "error", error: "unknown harbour: saint-malo", ms: 300 },
], { ms: 1500 });
put({ type: "custom", customType: "bash-titles", timestamp: iso(ts(200)), data: { toolCallId: b.id, title: "Predicts the tides of two harbours" } });
// Script C: a big nested write keeps only argumentsBytes; a nested edit beside it.
script("await tools.write({ path: \"src/predict.js\", content: big });\nawait tools.edit({ path: \"src/harbour.js\", edits: [...] });", [
  { name: "write", cut: true, arguments: { path: abs("src/predict.js"), content: lines(90, (i) => "export const k" + i + " = " + (i * 0.01).toFixed(2) + ";") } },
  { name: "edit", arguments: { path: abs("src/harbour.js"), edits: [{ oldText: "const DEFAULT = \"brest\";", newText: "const DEFAULT = process.env.TIDE_HARBOUR ?? \"brest\";" }] } },
], { ms: 2200 });
{
  // bash that edits a file, recorded by bash-changes on its result.
  const c = { id: id(), name: "bash", arguments: { command: "sed -i '' 's/saint-malo/saint_malo/' config/harbours.json" } };
  assistant([c]);
  const before = { "config/harbours.json": read("config/harbours.json") };
  writeFileSync(abs("config/harbours.json"), read("config/harbours.json").replace("saint-malo", "saint_malo"));
  result(c, { text: "", ms: 80, details: { fileChanges: changes(before) } });
}
{
  // A background bash whose bash-changes record comes later, as a session entry.
  const c = { id: id(), name: "bash", arguments: { command: "npx prettier --write src/units.js" } };
  assistant([c]);
  const before = { "src/units.js": read("src/units.js") };
  writeFileSync(abs("src/units.js"), read("src/units.js").replace("export const unit1 = 1;\n", "export const unit1 = 1; // metres\n"));
  result(c, { text: "src/units.js 12ms", ms: 1300 });
  put({ type: "custom", customType: "bash-changes", timestamp: iso(ts(100)), data: { toolCallId: c.id, fileChanges: changes(before) } });
}
// Untitled scripts of one step (R2-1: one row each): one that went well, one that threw on it.
script(`await tools.bash({ command: "git status -sb" });`, [{ name: "bash", arguments: { command: "git status -sb" }, ms: 180, out: "## main" }], { ms: 260 });
script(`await tools.bash({ command: "tide predict brest 2026-12-01" });`, [{ name: "bash", arguments: { command: "tide predict brest 2026-12-01" }, ms: 90, status: "error", error: "exit 2: no constituents for December", out: "no constituents for December" }], { ms: 140, threw: true });
{
  const c = { id: id(), name: "read", arguments: { path: abs("src/parse.js") } };
  assistant([c], { grow: 600, out: 900 }); result(c, { text: read("src/parse.js"), ms: 15 });
}
user("Thanks.");
assistant([], { grow: 300, out: 420 });

const base = out.join("\n") + "\n", calls = n;
writeFileSync(join(dir, "session.jsonl"), base);
// running: one more script, no result yet.
const run = { id: "toolu_running", name: "codemode", arguments: { code: "await tools.bash({ command: \"node --test tests --watch\" });" } };
out.length = 0; t = now - 20000; assistant([run], { grow: 500 });
writeFileSync(join(dir, "running.jsonl"), base + out.join("\n") + "\n");
// waiting: an ask without an answer.
const ask = { id: "toolu_waiting", name: "ask_user_question", arguments: { questions: [{ question: "Run the slow tide tests too?", header: "Tests", options: [] }] } };
out.length = 0; t = now - 15000; assistant([ask], { grow: 300 });
writeFileSync(join(dir, "waiting.jsonl"), base + out.join("\n") + "\n");

// cc: Claude Code's names and argument shapes (file_path, old_string), no scripts. Its edits
// aren't applied: the repo stays the main session's truth.
out.length = 0; n = 0; t = now - 30 * 60 * 1000; ctx = 30000;
put({ type: "session", version: 3, id: "syn-cc", cwd: repo, timestamp: iso(t) });
put({ type: "session_info", name: "tide-tables-cc", timestamp: iso(ts(10)) });
user("Check the harbour defaults.");
{
  const calls = [
    { id: id("toolu_cc"), name: "Bash", arguments: { command: "git log --oneline -3", description: "Recent commits" } },
    { id: id("toolu_cc"), name: "Read", arguments: { file_path: abs("src/harbour.js") } },
    { id: id("toolu_cc"), name: "Edit", arguments: { file_path: abs("src/harbour.js"), old_string: "// harbour 7", new_string: "// harbour 7 (checked)" } },
    { id: id("toolu_cc"), name: "Write", arguments: { file_path: abs("docs/harbours.md"), content: "# Harbours\n\nBrest, Saint-Malo.\n" } },
    { id: id("toolu_cc"), name: "Grep", arguments: { pattern: "DEFAULT", path: abs("src") } },
  ];
  assistant(calls);
  for (const c of calls) result(c, { text: "…", ms: 300 });
}
user("Thanks.");
assistant([], { grow: 200 });
writeFileSync(join(dir, "cc.jsonl"), out.join("\n") + "\n");

// empty: started, nothing called yet.
out.length = 0; t = now - 60 * 1000;
put({ type: "session", version: 3, id: "syn-empty", cwd: repo, timestamp: iso(t) });
put({ type: "session_info", name: "tide-tables-new", timestamp: iso(ts(10)) });
user("Look at the predictor.");
assistant([], { grow: 0, out: 40 });
writeFileSync(join(dir, "empty.jsonl"), out.join("\n") + "\n");
// big: the size of a long real session (440 untitled scripts, ~1 400 rows), to see the panel
// render that much in Herdr. Reads and bash only: the repo stays the main session's truth.
out.length = 0; t = now - 5 * 3600 * 1000; ctx = 20000;
put({ type: "session", version: 3, id: "syn-big", cwd: repo, timestamp: iso(t) });
put({ type: "session_info", name: "tide-tables-big", timestamp: iso(ts(10)) });
user("Go through every harbour.");
for (let i = 0; i < 440; i++) {
  const steps = [{ name: "read", arguments: { path: abs(FILES[i % FILES.length]) } }, { name: "bash", arguments: { command: `tide predict harbour-${i} 2026-11-17` }, ms: 300 }];
  if (i % 3 === 0) steps.push({ name: "bash", arguments: { command: `grep -n harbour-${i} src/harbour.js` }, ...(i % 30 === 0 ? { status: "error", error: "exit 1" } : {}) });
  script(`await tools.read(...); await tools.bash(...);`, steps, { ms: 900 });
}
assistant([], { grow: 100 });
writeFileSync(join(dir, "big.jsonl"), out.join("\n") + "\n");
console.log(JSON.stringify({ repo, session: join(dir, "session.jsonl"), running: join(dir, "running.jsonl"), calls }));
