#!/bin/sh
# A terminal that looks like Pi to Herdr, for info-shots: Pi's title ("π - <name> - <folder>")
# and one OSC 7501 status (app=pi) for its whole life, idle or working. It never changes: an
# agent going from working to idle while nobody looks posts "Pi finished" in every Herdr window
# of the core, the person's too. No model behind it; the panel reads the pi.session label.
#   info-fake-pi <title> idle|working
title=$1 state=$2
case $state in idle|working) ;; *) echo "state: idle or working" >&2; exit 1 ;; esac
printf '\033]0;%s\007' "$title"
printf '\033]7501;state=%s:app=pi:msg=%s\033\\' "$state" "$(printf %s "$title" | base64)"
printf 'Not Pi: a stand-in for the Info panel shots (%s, %s).\n' "$title" "$state"
exec sleep 2147483647
