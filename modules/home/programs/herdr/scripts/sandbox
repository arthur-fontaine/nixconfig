#!/usr/bin/env bash
# A throwaway Herdr window on this checkout's mods, beside the person's own: a home under /tmp
# laid out as default.nix deploys it, opened with HERDR_APP_HOME. It shares the real herdr-core,
# kanban daemon and LSP bridge, so what it shows (and closes) is real.
#
#   sandbox up            build the home, open the window, record its PID
#   sandbox sync          redeploy mods, themes, layout and nix-editor files after edits
#   sandbox app <args>    herdr-app on the sandbox window (ls, status, check, commands)
#   sandbox do <cmd> ...  herdr-app do on the sandbox window; spaces/tabs it creates are recorded
#   sandbox shot <file>   screenshot of the sandbox window
#   sandbox appearance light|dark   the sandbox's appearance (its settings.json, applied live)
#   sandbox variant nix|<name>      show layouts/nix.json or layouts/nix-islands-<name>.json
#   sandbox fixture       a throwaway repo (k31-fixture) with two worktrees, for destructive tests
#   sandbox keys          merge default.nix's keys into the keys.json Herdr wrote
#   sandbox act <cmd> ... herdr-app do, only while the shown space is one `do` made
#   sandbox down          close what `do` created, kill only the recorded PID, remove the home
set -euo pipefail

herdr=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
repo=$(git -C "$herdr" rev-parse --show-toplevel)
root=${HERDR_SANDBOX:-/tmp/herdr-sandbox}
home=$root/home
pidfile=$root/pid
created=$root/created
bin=/Applications/Herdr.app/Contents/MacOS/Herdr
deployed=$HOME/.config/herdr-app

case $root in /tmp/herdr-sandbox*|/private/tmp/herdr-sandbox*) ;; *) echo "HERDR_SANDBOX must be under /tmp/herdr-sandbox" >&2; exit 1 ;; esac

app() { HERDR_APP_HOME=$home herdr-app "$@"; }

running() {
  [ -f "$pidfile" ] || return 1
  local pid; pid=$(cat "$pidfile")
  # The PID may have been reused: it must still be Herdr on this home.
  ps eww -p "$pid" -o command= 2>/dev/null | grep -q "^$bin.*HERDR_APP_HOME=$home\b"
}

# default.nix's bundle: shared _lib files and the mod's modules without `export` (and the
# modules without their relative imports), then main.js without its relative imports.
bundle() {
  local mod=$1 spec=$2 f
  {
    for f in $(jq -r '.shared // [] | .[]' <<<"$spec"); do sed 's/^export //' "$herdr/mods/_lib/$f"; done
    for f in $(jq -r '.modules // [] | .[]' <<<"$spec"); do
      sed -e 's/^export //' -e '/^import .* from "\.\.\{0,1\}\//d' "$herdr/mods/$mod/$f"
    done
    grep -v -E '^import .* from "(\./|\.\./)' "$herdr/mods/$mod/main.js"
  }
}

deploy() {
  local mods mod spec
  mods=$(nix eval --json --file "$herdr/mods.nix")
  for mod in $(jq -r 'keys[]' <<<"$mods"); do
    spec=$(jq -c --arg m "$mod" '.[$m]' <<<"$mods")
    mkdir -p "$home/mods/$mod"
    # Herdr writes jsconfig.json and .d.ts files beside them: only these two are replaced.
    if [ "$spec" = "{}" ]; then cp "$herdr/mods/$mod/main.js" "$home/mods/$mod/main.js"
    else bundle "$mod" "$spec" >"$home/mods/$mod/main.js"; fi
    cp "$herdr/mods/$mod/mod.json" "$home/mods/$mod/mod.json"
  done
  # Real files: Herdr draws no svg through a link.
  rm -rf "$home/mods/nix-head/icons"
  mkdir -p "$home/mods/nix-head/icons" "$home/themes" "$home/layouts" "$home/nix-editor"
  cp "$herdr"/mods/nix-head/icons/*.svg "$home/mods/nix-head/icons/"
  cp "$herdr"/themes/nix-*.json "$home/themes/"
  # nix.json and any variant beside it (nix-*.json), not deployed by nix until one is picked.
  cp "$herdr"/layouts/nix*.json "$home/layouts/"
  cp "$herdr/nix-editor/init.lua" "$herdr/nix-editor/diff.lua" "$home/nix-editor/"
  # The Ayu colors are a nixpkgs plugin, not in the repo: the deployed one.
  [ -e "$home/nix-editor/ayu" ] || ln -s "$(readlink -f "$deployed/nix-editor/ayu")" "$home/nix-editor/ayu"
}

# settings.json and shared.json: the keys default.nix merges in, read from the flake. Written
# before the window opens only, since a running Herdr keeps them in memory and saves over them.
settings() {
  local cfg="#darwinConfigurations.Arthur-Mac.config.home-manager.users.$USER.nixconfig.sync"
  nix eval --json "$repo$cfg.herdr-settings.managed" >"$home/settings.json"
  # Welcomed already: the welcome would cover every shot.
  nix eval --json "$repo$cfg.herdr-shared.managed" | jq '. + {"frame.welcomed": "finished"}' >"$home/shared.json"
}

# The fixture's real path: git reports /private/tmp, and the mods compare paths as strings.
fixture=$(mkdir -p "$root" && cd "$root" && pwd -P)/k31-fixture

cmd=${1:-}; shift || true
case $cmd in
  up)
    if running; then echo "already up: PID $(cat "$pidfile"), home $home"; exit 0; fi
    mkdir -p "$home"
    deploy
    settings
    : >"$created"
    HERDR_APP_HOME=$home nohup "$bin" >"$root/log" 2>&1 &
    echo $! >"$pidfile"
    for _ in $(seq 50); do [ -S "$home/herdr-app.sock" ] && break; sleep 0.2; done
    running || { echo "Herdr didn't start; see $root/log" >&2; exit 1; }
    echo "up: PID $(cat "$pidfile"), home $home"
    ;;
  sync) deploy; echo "synced $home" ;;
  app) app "$@" ;;
  do)
    out=$(app do "$@") || { echo "$out"; exit 1; }
    echo "$out"
    # Only what this call made: a reply names the space a new tab went into too.
    case ${1:-} in
      space.new) jq -r '"space \(.space)"' <<<"$out" >>"$created" ;;
      tab.new) jq -r '"tab \(.tab)"' <<<"$out" >>"$created" ;;
    esac
    ;;
  shot) app shot "${1:?shot <file.png>}" ;;
  variant)
    name=${1:?variant nix|<name>}; [ "$name" = nix ] || name=nix-islands-$name
    [ -f "$home/layouts/$name.json" ] || { echo "no layouts/$name.json in the sandbox" >&2; exit 1; }
    app do layout.switch --name "$name" >/dev/null
    sleep 1
    # An invalid layout keeps the last good one: say so rather than shoot the wrong window.
    shown=$(app status | jq -r .layout)
    [ "$shown" = "$name" ] || { echo "still showing $shown" >&2; cat "$home/layouts/$name.error" 2>/dev/null >&2; exit 1; }
    echo "showing $name"
    ;;
  fixture)
    if ! git -C "$fixture/main" rev-parse -q --verify HEAD >/dev/null 2>&1; then
      git init -q -b main "$fixture/main"
      # Its own identity and no signing: the person's global git config stays out of it.
      git -C "$fixture/main" -c user.name=sandbox -c user.email=sandbox@localhost -c commit.gpgsign=false commit -q --allow-empty -m "fixture: first commit"
      git -C "$fixture/main" worktree add -q -b wt-a "$fixture/wt-a"
      git -C "$fixture/main" worktree add -q -b wt-b "$fixture/wt-b"
    fi
    git -C "$fixture/main" worktree list
    ;;
  keys)
    running || { echo "the sandbox isn't up" >&2; exit 1; }
    cfg="#darwinConfigurations.Arthur-Mac.config.home-manager.users.$USER.nixconfig.sync.herdr-keys.managed"
    tmp=$(mktemp)
    # After start: Herdr writes its defaults first, nix's keys go on top, as activation merges them.
    nix eval --json "$repo$cfg" 2>/dev/null | jq -s '.[0] * .[1]' "$home/keys.json" - >"$tmp" && mv "$tmp" "$home/keys.json"
    sleep 1
    [ ! -e "$home/keys.error" ] || { cat "$home/keys.error" >&2; exit 1; }
    jq -c '.global | with_entries(select(.value|tostring|test("^nix-")))' "$home/keys.json"
    ;;
  act)
    # Mod commands carry no target: they act on what the sandbox shows. Only ever on our own.
    shown=$(app status | jq -r .space)
    grep -q "^space $shown$" "$created" || { echo "refused: the shown space $shown isn't one the sandbox made" >&2; exit 1; }
    app do "$@"
    ;;
  appearance)
    case ${1:-} in light|dark) ;; *) echo "appearance light|dark" >&2; exit 1 ;; esac
    tmp=$(mktemp) && jq --arg a "$1" '.appearance = $a' "$home/settings.json" >"$tmp" && mv "$tmp" "$home/settings.json"
    ;;
  down)
    if ! running && [ -s "$created" ]; then
      # Without the window nothing can close them: say what is left rather than lose track.
      echo "the sandbox window is gone; these are still open (close them yourself):" >&2
      cat "$created" >&2
      exit 1
    fi
    if running; then
      # What `do` made, newest first. Nothing else is touched.
      awk '!seen[$0]++' "$created" | tail -r | while read -r kind id; do
        app do "$kind.close" --id "$id" --confirmed true >/dev/null || true
      done
      kill "$(cat "$pidfile")"
    fi
    rm -rf "$root"
    echo "down"
    ;;
  *) sed -n '2,18p' "$0" | sed 's/^# \{0,1\}//'; exit 1 ;;
esac
