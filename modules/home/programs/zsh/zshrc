# Enable Powerlevel10k instant prompt. Should stay close to the top of ~/.zshrc.
# Initialization code that may require console input (password prompts, [y/n]
# confirmations, etc.) must go above this block; everything else may go below.
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

# Set the zsh config directory
export ZSHRCD=~/.config/zsh/zshrc.d

# ez-compinit runs compinit at the first prompt, from a dump it rebuilds once a day: a
# shell that only runs a command (zsh -lic) never pays for completions.
zstyle ':plugin:ez-compinit' 'use-cache' yes

# Activate Antidote
source /opt/homebrew/opt/antidote/share/antidote/antidote.zsh

# zsh_plugins.zsh is generated from zsh_plugins.txt (faster than `antidote load`).
# Regenerate it when it is missing or references a bundle directory that is not on disk.
() {
  local plugins=~/.config/zsh/zsh_plugins.zsh line stale=0
  [[ -s $plugins ]] || stale=1
  # $(<file) is read by zsh itself; with a redirection added it runs cat.
  (( stale )) || for line in ${(M)${(f)"$(<$plugins)"}:#*fpath+=*}; do
    [[ -d ${(e)${${line#*\"}%%\"*}} ]] || { stale=1; break }
  done
  (( stale )) && antidote bundle < ~/.config/zsh/zsh_plugins.txt >| $plugins
}
source ~/.config/zsh/zsh_plugins.zsh
# If you want to load plugins from zsh_plugins.txt instead of the generated zsh_plugins.zsh file, uncomment the following line:
# antidote load ~/.config/zsh/zsh_plugins.txt

# The rest of the config is in the ./.config/zshrc.d directory

